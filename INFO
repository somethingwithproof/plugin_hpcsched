; remote_poller:1 is what lets poller_bottom, and so the reader, run on a
; remote collector (lib/plugins.php gates poller_bottom on it alone).
; remote_collect:1 affects only hooks this plugin does not register; it is
; declared as plugin_pfs does, so the collector role is stated either way.
[info]
name = hpcsched
version = 0.1.0-dev
longname = HPC Scheduler
author = "Thomas Vincent (somethingwithproof)"
email = thomasvincent@gmail.com
homepage = https://github.com/somethingwithproof/plugin_hpcsched
compat = 1.2.31
capabilities = online_view:1, online_mgmt:1, offline_view:0, offline_mgmt:0, remote_collect:1, remote_poller:1
