#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Các mẫu HPC Scheduler chưa được cài đặt. Hãy cài đặt chúng từ trang tình trạng."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Một thiết bị \"%s\" từ mẫu thiết bị %s, được thăm dò bởi trình thăm dò %d, với kiểm tra tính khả dụng đã tắt."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Truy vấn dữ liệu \"%s\", đang lập chỉ mục %d phân vùng hiện biết."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d biểu đồ cụm, mỗi biểu đồ có nguồn dữ liệu \"%s\" riêng."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d biểu đồ phân vùng, %d cho mỗi phân vùng, mỗi biểu đồ có nguồn dữ liệu riêng."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Tổng cộng: %d nguồn dữ liệu và %d tệp RRD, và %d lệnh gọi máy chủ tập lệnh mỗi lần thăm dò. Các phân vùng được thêm sau sẽ nhận biểu đồ từ trang Biểu đồ mới."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Được tạo bởi plugin HPC Scheduler cho cụm %s. Các giá trị của nó đến từ ảnh chụp nhanh của plugin; tên máy chủ là tên dành riêng và không bao giờ được liên hệ."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "cấu hình: một đường dẫn, URL hoặc cài đặt bị thiếu hoặc không được phép"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "không thể liên hệ được với trình lập lịch"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "lệnh gọi mất nhiều thời gian hơn mức cho phép và đã bị dừng"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "phản hồi lớn hơn mức cho phép và đã bị loại bỏ"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "không thể phân tích cú pháp phản hồi bằng trình phân tích dữ liệu đã ghim"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "trình lập lịch đã từ chối thông tin xác thực"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "tài khoản trình lập lịch có thể không được xem dữ liệu này (PrivateData hoặc quyền)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "bộ điều khiển đã yêu cầu các máy khách tạm dừng (giới hạn tốc độ)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "máy chủ đã trả lời 304 cho một yêu cầu không có điều kiện; dữ liệu trước đó được giữ lại"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "plugin đã từ chối một lệnh gọi nằm ngoài danh sách cho phép của nó"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "lệnh gọi thất bại"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "trình đọc hết bộ nhớ; hãy giảm Kích thước phản hồi tối đa hoặc tăng Bộ nhớ thu thập trong Cài đặt"

