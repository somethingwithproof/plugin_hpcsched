msgstr "Việc thêm các biểu đồ bị thiếu sẽ thêm:"

#: lib/ClustersPage.php
msgid "Add Missing Graphs"
msgstr "Thêm biểu đồ bị thiếu"

#: lib/ClustersPage.php
