#: hpcsched_clusters.php
msgid "You do not have permission for the device of that cluster."
msgstr "Bạn không có quyền đối với thiết bị của cụm đó."

#: hpcsched_clusters.php
msgid "Name: another cluster already uses this name."
msgstr "Tên: một cụm khác đã sử dụng tên này."

#: hpcsched_clusters.php
msgid "The cluster was not saved: it was changed by someone else since the form was opened, or the write failed. Open it again and repeat the change."
msgstr "Cụm chưa được lưu: cụm đã bị người khác thay đổi kể từ khi biểu mẫu được mở, hoặc việc ghi bị lỗi. Hãy mở lại và thực hiện lại thay đổi."

#: hpcsched_clusters.php
msgid "The cluster was saved."
msgstr "Cụm đã được lưu."

#: hpcsched_clusters.php
msgid "The cluster state was not changed: the write failed. See the Cacti log."
msgstr "Trạng thái cụm chưa được thay đổi: việc ghi bị lỗi. Xem nhật ký Cacti."

#: hpcsched_clusters.php
msgid "The cluster and its cached snapshot were deleted. Its device and graphs were kept. The scheduler was not contacted."
msgstr "Cụm và ảnh chụp nhanh được lưu trong bộ nhớ đệm của nó đã bị xóa. Thiết bị và biểu đồ của nó vẫn được giữ lại. Trình lập lịch đã không được liên hệ."

#: hpcsched_clusters.php
msgid "The device and its graphs were created."
msgstr "Thiết bị và các biểu đồ của nó đã được tạo."

#: hpcsched_clusters.php
msgid "The device was not created: the cluster already has a device, it was changed by someone else since the page was opened, or Cacti refused it. See the Cacti log."
msgstr "Thiết bị chưa được tạo: cụm đã có thiết bị, cụm đã bị người khác thay đổi kể từ khi trang được mở, hoặc Cacti đã từ chối. Xem nhật ký Cacti."

#: hpcsched_clusters.php
msgid "The cluster was mapped to the device."
msgstr "Cụm đã được ánh xạ tới thiết bị."

#: hpcsched_clusters.php
msgid "The cluster was not mapped: the device does not exist, is not allowed to you, already carries another cluster, or the cluster was changed by someone else since the page was opened."
msgstr "Cụm chưa được ánh xạ: thiết bị không tồn tại, không được phép đối với bạn, đã gắn với một cụm khác, hoặc cụm đã bị người khác thay đổi kể từ khi trang được mở."

#: hpcsched_clusters.php
msgid "Missing graphs were added."
msgstr "Các biểu đồ bị thiếu đã được thêm."

#: hpcsched_clusters.php
msgid "No graphs were added: the cluster has no device, or its device no longer exists."
msgstr "Không có biểu đồ nào được thêm: cụm không có thiết bị, hoặc thiết bị của nó không còn tồn tại."

#: hpcsched_clusters.php
msgid "The cluster was not unmapped: it was changed by someone else since the page was opened."
msgstr "Cụm chưa được hủy ánh xạ: cụm đã bị người khác thay đổi kể từ khi trang được mở."

#: hpcsched_clusters.php
msgid "The cluster was unmapped. The device and its graphs were kept."
msgstr "Cụm đã được hủy ánh xạ. Thiết bị và các biểu đồ của nó vẫn được giữ lại."

#: hpcsched_clusters.php
msgid "The partitions were reindexed from the snapshot."
msgstr "Các phân vùng đã được lập chỉ mục lại từ ảnh chụp nhanh."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the device is disabled or down, so Cacti skipped its data query."
msgstr "Các phân vùng chưa được lập chỉ mục lại: thiết bị đang bị tắt hoặc ngừng hoạt động, vì vậy Cacti đã bỏ qua truy vấn dữ liệu của nó."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: Cacti could not run the data query. See the Cacti log."
msgstr "Các phân vùng chưa được lập chỉ mục lại: Cacti không thể chạy truy vấn dữ liệu. Xem nhật ký Cacti."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the HPC Scheduler data query is not installed. Install the templates from the health page."
msgstr "Các phân vùng chưa được lập chỉ mục lại: truy vấn dữ liệu HPC Scheduler chưa được cài đặt. Hãy cài đặt các mẫu từ trang tình trạng."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the cluster has no device, or its device no longer exists."
msgstr "Các phân vùng chưa được lập chỉ mục lại: cụm không có thiết bị, hoặc thiết bị của nó không còn tồn tại."

#: hpcsched_health.php
msgid "The HPC Scheduler templates are installed."
msgstr "Các mẫu HPC Scheduler đã được cài đặt."

#: hpcsched_health.php
#, php-format
msgid "The templates were not installed: %s"
msgstr "Các mẫu chưa được cài đặt: %s"

#: hpcsched_operator.php
msgid "Monitoring view"
msgstr "Chế độ xem giám sát"

#: hpcsched_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Không thể đọc các quan sát. Hãy yêu cầu quản trị viên kiểm tra nhật ký plugin."

#: include/operator.php
msgid "Inspect pending reason families and snapshot freshness on the overview. Escalate credentials, cluster mappings and maintenance policy to an administrator."
msgstr "Kiểm tra các nhóm lý do đang chờ và độ mới của ảnh chụp nhanh trên trang tổng quan. Chuyển thông tin xác thực, ánh xạ cụm và chính sách bảo trì lên quản trị viên."

#: lib/ClusterInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Tên: sử dụng từ 1 đến 64 chữ cái, chữ số, dấu chấm, dấu gạch ngang hoặc dấu gạch dưới, bắt đầu bằng chữ cái hoặc chữ số."

#: lib/ClusterInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: chọn một trong các poller được liệt kê."

#: lib/ClusterInput.php
#, php-format
msgid "Collection Interval: enter whole seconds from %d to %d."
msgstr "Khoảng thời gian thu thập: nhập số giây nguyên từ %d đến %d."

#: lib/ClusterInput.php
msgid "Transport: choose one of the listed transports."
msgstr "Phương thức truyền tải: chọn một trong các phương thức truyền tải được liệt kê."

#: lib/ClusterInput.php
msgid "slurm.conf: enter an absolute path, or leave it empty to use the poller default."
msgstr "slurm.conf: nhập đường dẫn tuyệt đối, hoặc để trống để dùng giá trị mặc định của trình thăm dò."

#: lib/ClusterInput.php
msgid "slurmrestd URL: this host and port are not on the slurmrestd host list in Settings."
msgstr "URL slurmrestd: máy chủ và cổng này không nằm trong danh sách máy chủ slurmrestd trong Cài đặt."

#: lib/ClusterInput.php
msgid "slurmrestd URL: enter an https:// URL without user name, query, or fragment; plain http:// is accepted only for a loopback address."
msgstr "URL slurmrestd: nhập một URL https:// không có tên người dùng, chuỗi truy vấn hoặc phân đoạn; http:// thuần chỉ được chấp nhận cho địa chỉ loopback."

#: lib/ClusterInput.php
msgid "slurmrestd User: use at most 64 letters, digits, dots, dashes, or underscores, or leave it empty for a user token."
msgstr "Người dùng slurmrestd: sử dụng tối đa 64 chữ cái, chữ số, dấu chấm, dấu gạch ngang hoặc dấu gạch dưới, hoặc để trống để dùng mã thông báo người dùng."

#: lib/ClusterInput.php
msgid "Token File: enter the absolute path of the token file on the poller. The token itself is never entered here."
msgstr "Tệp mã thông báo: nhập đường dẫn tuyệt đối của tệp mã thông báo trên trình thăm dò. Bản thân mã thông báo không bao giờ được nhập tại đây."

#: lib/ClusterInput.php
msgid "Token File: no token file directories are set yet. Ask a Cacti administrator to set them under Settings, HPC Scheduler."
msgstr "Tệp mã thông báo: chưa có thư mục tệp mã thông báo nào được thiết lập. Hãy yêu cầu quản trị viên Cacti thiết lập chúng trong Cài đặt, HPC Scheduler."

#: lib/ClusterInput.php
#, php-format
msgid "Token File: the file must be inside one of the token file directories set in Settings (%s)."
msgstr "Tệp mã thông báo: tệp phải nằm bên trong một trong các thư mục tệp mã thông báo được thiết lập trong Cài đặt (%s)."

