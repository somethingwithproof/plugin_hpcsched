#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Ibyitegererezo bya HPC Scheduler ntibyashyizwemo. Bishyiremo uvuye ku rupapuro rw'ubuzima bwa sisitemu."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Igikoresho \"%s\" kivuye ku cyitegererezo cy'igikoresho %s, gikusanywa n'umukusanyamakuru %d, igenzura ryo kuboneka ryafunzwe."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Ishakisha ry'amakuru \"%s\", ribara ibice %d bizwi ubu."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Ibishushanyo by'ihuriro %d, buri kimwe gifite isoko yacyo y'amakuru \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Ibishushanyo by'ibice %d, %d kuri buri gice, buri kimwe gifite isoko yacyo y'amakuru."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Muri rusange: amasoko y'amakuru %d na dosiye za RRD %d, n'ibisabwa kuri script server %d muri buri kusanya. Ibice byongeweho nyuma bibona ibishushanyo bivuye ku rupapuro rw'Ibishushanyo Bishya."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Byaremwe n'umugereka wa HPC Scheduler ku bw'ihuriro %s. Agaciro kabyo kava ku ishusho y'ako kanya y'umugereka; izina rya host ni izina ryabikiwe ritigera rivugishwa."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "igenamiterere: inzira, URL, cyangwa igenamiterere rirabura cyangwa ntiryemewe"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "umugenga w'imirimo ntiyashoboye kugerwaho"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "igisabwa cyamaze igihe kirenga icyemewe maze gihagarikwa"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "igisubizo cyari kinini kurusha uko byemewe maze kirajugunywa"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "igisubizo nticyashoboye gusesengurwa n'umusesenguzi w'amakuru watoranyijwe"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "umugenga w'imirimo yanze icyangombwa cyo kwinjira"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "konti y'umugenga w'imirimo ishobora kutabona aya makuru (PrivateData cyangwa uburenganzira)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "umugenzuzi yasabye abakiriya kugabanya umuvuduko (rate limit)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "seriveri yasubije 304 ku gisabwa kitari gifite ibisabwa; amakuru ya mbere yagumishijweho"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "umugereka wanze igisabwa kiri hanze y'urutonde rw'ibyemewe"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "igisabwa cyananiranye"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "umusomyi yashizeho ububiko (memory); gabanya Ingano Ntarenzwa y'Igisubizo cyangwa wongere Ububiko bw'Ikusanya muri Igenamiterere"

