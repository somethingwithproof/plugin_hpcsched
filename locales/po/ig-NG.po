#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "plugin ahụ jụrụ oku na-abụghị na ndepụta nnabata ya"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "oku ahụ dara ada"

#: lib/ErrorClass.php
