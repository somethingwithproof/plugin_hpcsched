msgid "The HPC Scheduler templates are installed."
msgstr "Etinyere ndebiri HPC Scheduler."

#: hpcsched_health.php
#, php-format
msgid "The templates were not installed: %s"
msgstr "Etinyeghị ndebiri ndị ahụ: %s"

#: hpcsched_operator.php
msgid "Monitoring view"
msgstr "Nlere nleba anya"

#: hpcsched_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Enweghị ike ịgụ nchọpụta ndị ahụ. Gwa onye nchịkwa ka ọ lelee ndekọ mgbakwunye ahụ."

#: include/operator.php
msgid "Inspect pending reason families and snapshot freshness on the overview. Escalate credentials, cluster mappings and maintenance policy to an administrator."
msgstr "Nyochaa ezinụlọ ihe kpatara nchere na ịdị ọhụrụ nke nseta foto na nchịkọta. Ziga nzere, njikọ klọsta na atụmatụ mmezi nye onye nchịkwa."

#: lib/ClusterInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Aha: jiri mkpụrụedemede, ọnụọgụ, ntụpọ, akara uhie, ma ọ bụ akara ala site na 1 ruo 64, malite na mkpụrụedemede ma ọ bụ ọnụọgụ."

#: lib/ClusterInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: họrọ otu n'ime poller ndị e depụtara."

#: lib/ClusterInput.php
#, php-format
msgid "Collection Interval: enter whole seconds from %d to %d."
msgstr "Oge Nchịkọta: tinye sekọnd zuru ezu site na %d ruo %d."

#: lib/ClusterInput.php
msgid "Transport: choose one of the listed transports."
msgstr "Ụzọ Nbufe: họrọ otu n'ime ụzọ nbufe edepụtara."

#: lib/ClusterInput.php
msgid "slurm.conf: enter an absolute path, or leave it empty to use the poller default."
msgstr "slurm.conf: tinye ụzọ zuru oke (absolute path), ma ọ bụ hapụ ya ka ọ tọgbọrọ chakoo iji jiri ndabere poller."

#: lib/ClusterInput.php
msgid "slurmrestd URL: this host and port are not on the slurmrestd host list in Settings."
msgstr "slurmrestd URL: host na port a anọghị na ndepụta host slurmrestd na Ntọala."

#: lib/ClusterInput.php
msgid "slurmrestd URL: enter an https:// URL without user name, query, or fragment; plain http:// is accepted only for a loopback address."
msgstr "slurmrestd URL: tinye URL https:// na-enweghị aha onye ọrụ, ajụjụ, ma ọ bụ mpempe; a na-anabata http:// nkịtị naanị maka adreesị loopback."

#: lib/ClusterInput.php
msgid "slurmrestd User: use at most 64 letters, digits, dots, dashes, or underscores, or leave it empty for a user token."
msgstr "Onye Ọrụ slurmrestd: jiri ihe kachasị mkpụrụedemede, ọnụọgụ, ntụpọ, akara uhie, ma ọ bụ akara ala 64, ma ọ bụ hapụ ya ka ọ tọgbọrọ chakoo maka token onye ọrụ."

#: lib/ClusterInput.php
msgid "Token File: enter the absolute path of the token file on the poller. The token itself is never entered here."
msgstr "Faịlụ Token: tinye ụzọ zuru oke nke faịlụ token na poller. A naghị etinye token n'onwe ya ebe a."

#: lib/ClusterInput.php
msgid "Token File: no token file directories are set yet. Ask a Cacti administrator to set them under Settings, HPC Scheduler."
msgstr "Faịlụ Token: edobebeghị ndekọ faịlụ token ọ bụla. Gwa onye nchịkwa Cacti ka ọ tọọ ha n'okpuru Ntọala, HPC Scheduler."

#: lib/ClusterInput.php
#, php-format
msgid "Token File: the file must be inside one of the token file directories set in Settings (%s)."
msgstr "Faịlụ Token: faịlụ ahụ ga-adịrịrị n'ime otu n'ime ndekọ faịlụ token etinyere na Ntọala (%s)."

