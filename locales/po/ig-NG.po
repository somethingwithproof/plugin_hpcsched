msgstr "enweghị ike iji ngwa nyocha data (data parser) akpọchiri nyochaa azịza ahụ"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "scheduler ahụ jụrụ nzere ahụ"

#: lib/ErrorClass.php
