#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Maksimalna veličina odgovora iznosi %d MiB, ali dekodirani odgovor te veličine ne staje u Memoriju za prikupljanje od %d MiB; čitač dozvoljava %d MiB. Povećajte Memoriju za prikupljanje ili smanjite Maksimalnu veličinu odgovora u Postavkama."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Dodijeljeno polleru %d, udaljenom prikupljaču podataka. Ovo izdanje prikuplja podatke samo na glavnom polleru, pa se klaster ne prikuplja; udaljeno prikupljanje je planirano za fazu 3. Dodijelite ga glavnom polleru."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Interval prikupljanja je ispod donje granice od %d sekundi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Interval prikupljanja od %d sekundi kraći je od intervala pollera od %d sekundi; podaci se prikupljaju svakih %d sekundi."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "Do slurmrestd se pristupa preko običnog HTTP-a na loopback adresi; token prolazi kroz lokalni mrežni stek nešifrovan."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Nijedno pokretanje čitača još nije završeno za ovaj klaster."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Datoteka tokena: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Token je istekao %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Token ističe za %d minuta."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "Posljednje pokretanje iskoristilo je cijeli vremenski budžet od %d sekundi; neke sekcije nisu prikupljene."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "Planer prijavljuje Slurm %s, što nije podržano izdanje (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "Planer prijavljuje Slurm %s, koji ne sadrži parser podataka %s odabran u Postavkama."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Klijentske komande su se izvršavale bez ograničenja memorije; podesite putanju do prlimit u Postavkama."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
