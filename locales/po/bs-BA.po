#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Šabloni za HPC Scheduler nisu instalirani. Instalirajte ih sa stranice stanja sistema."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Uređaj \"%s\" iz šablona uređaja %s, koji ispituje poller %d, s isključenim provjerama dostupnosti."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Upit za podatke \"%s\", koji indeksira trenutno poznatih %d particija."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d grafikona klastera, svaki sa sopstvenim izvorom podataka \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d grafikona particija, po %d za svaku particiju, svaki sa sopstvenim izvorom podataka."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Ukupno: %d izvora podataka i %d RRD datoteka, te %d poziva script servera po ispitivanju. Kasnije dodane particije dobijaju grafikone sa stranice Novi grafikoni."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Kreirao dodatak HPC Scheduler za klaster %s. Njegove vrijednosti dolaze iz snimka dodatka; naziv hosta je rezervisano ime koje se nikada ne kontaktira."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "konfiguracija: putanja, URL ili postavka nedostaje ili nije dozvoljena"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "nije bilo moguće stupiti u kontakt s planerom"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "poziv je trajao duže od dozvoljenog i zaustavljen je"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "odgovor je bio veći od dozvoljenog i odbačen je"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "odgovor nije mogao biti raščlanjen zadatim parserom podataka"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "planer je odbio kredencijal"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "nalog planera možda ne vidi ove podatke (PrivateData ili dozvole)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "kontroler je zatražio od klijenata da uspore (ograničenje učestalosti)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "server je vratio 304 na zahtjev koji nije bio uslovan; prethodni podaci su zadržani"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "dodatak je odbio poziv izvan svog spiska dozvoljenih"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "poziv nije uspio"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "čitač je ostao bez memorije; smanjite Maksimalnu veličinu odgovora ili povećajte Memoriju za prikupljanje u Postavkama"

