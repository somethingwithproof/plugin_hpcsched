#: hpcsched_clusters.php
msgid "You do not have permission for the device of that cluster."
msgstr "Nemate dozvolu za uređaj tog klastera."

#: hpcsched_clusters.php
msgid "Name: another cluster already uses this name."
msgstr "Naziv: drugi klaster već koristi ovaj naziv."

#: hpcsched_clusters.php
msgid "The cluster was not saved: it was changed by someone else since the form was opened, or the write failed. Open it again and repeat the change."
msgstr "Klaster nije sačuvan: neko drugi ga je izmijenio otkako je obrazac otvoren ili upisivanje nije uspjelo. Otvorite ga ponovo i ponovite izmjenu."

#: hpcsched_clusters.php
msgid "The cluster was saved."
msgstr "Klaster je sačuvan."

#: hpcsched_clusters.php
msgid "The cluster state was not changed: the write failed. See the Cacti log."
msgstr "Stanje klastera nije promijenjeno: upisivanje nije uspjelo. Pogledajte zapisnik Cacti."

#: hpcsched_clusters.php
msgid "The cluster and its cached snapshot were deleted. Its device and graphs were kept. The scheduler was not contacted."
msgstr "Klaster i njegov keširani snimak su obrisani. Njegov uređaj i grafikoni su zadržani. Planer nije kontaktiran."

#: hpcsched_clusters.php
msgid "The device and its graphs were created."
msgstr "Uređaj i njegovi grafikoni su kreirani."

#: hpcsched_clusters.php
msgid "The device was not created: the cluster already has a device, it was changed by someone else since the page was opened, or Cacti refused it. See the Cacti log."
msgstr "Uređaj nije kreiran: klaster već ima uređaj, neko drugi ga je izmijenio otkako je stranica otvorena ili je Cacti odbio zahtjev. Pogledajte zapisnik Cacti."

#: hpcsched_clusters.php
msgid "The cluster was mapped to the device."
msgstr "Klaster je mapiran na uređaj."

#: hpcsched_clusters.php
msgid "The cluster was not mapped: the device does not exist, is not allowed to you, already carries another cluster, or the cluster was changed by someone else since the page was opened."
msgstr "Klaster nije mapiran: uređaj ne postoji, nije vam dozvoljen, već nosi drugi klaster ili je neko drugi izmijenio klaster otkako je stranica otvorena."

#: hpcsched_clusters.php
msgid "Missing graphs were added."
msgstr "Nedostajući grafikoni su dodani."

#: hpcsched_clusters.php
msgid "No graphs were added: the cluster has no device, or its device no longer exists."
msgstr "Nijedan grafikon nije dodan: klaster nema uređaj ili njegov uređaj više ne postoji."

#: hpcsched_clusters.php
msgid "The cluster was not unmapped: it was changed by someone else since the page was opened."
msgstr "Mapiranje klastera nije uklonjeno: neko drugi ga je izmijenio otkako je stranica otvorena."

#: hpcsched_clusters.php
msgid "The cluster was unmapped. The device and its graphs were kept."
msgstr "Mapiranje klastera je uklonjeno. Uređaj i njegovi grafikoni su zadržani."

#: hpcsched_clusters.php
msgid "The partitions were reindexed from the snapshot."
msgstr "Particije su ponovo indeksirane iz snimka."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the device is disabled or down, so Cacti skipped its data query."
msgstr "Particije nisu ponovo indeksirane: uređaj je onemogućen ili nedostupan, pa je Cacti preskočio njegov upit za podatke."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: Cacti could not run the data query. See the Cacti log."
msgstr "Particije nisu ponovo indeksirane: Cacti nije mogao pokrenuti upit za podatke. Pogledajte zapisnik Cacti."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the HPC Scheduler data query is not installed. Install the templates from the health page."
msgstr "Particije nisu ponovo indeksirane: upit za podatke za HPC Scheduler nije instaliran. Instalirajte šablone sa stranice stanja sistema."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the cluster has no device, or its device no longer exists."
msgstr "Particije nisu ponovo indeksirane: klaster nema uređaj ili njegov uređaj više ne postoji."

#: hpcsched_health.php
msgid "The HPC Scheduler templates are installed."
msgstr "Šabloni za HPC Scheduler su instalirani."

#: hpcsched_health.php
#, php-format
msgid "The templates were not installed: %s"
msgstr "Šabloni nisu instalirani: %s"

#: hpcsched_operator.php
msgid "Monitoring view"
msgstr "Prikaz nadzora"

#: hpcsched_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Opažanja nije bilo moguće pročitati. Zamolite administratora da provjeri zapisnik dodatka."

#: include/operator.php
msgid "Inspect pending reason families and snapshot freshness on the overview. Escalate credentials, cluster mappings and maintenance policy to an administrator."
msgstr "Provjerite porodice razloga čekanja i svježinu snimaka na pregledu. Kredencijale, mapiranja klastera i politiku održavanja proslijedite administratoru."

#: lib/ClusterInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Naziv: koristite od 1 do 64 slova, cifre, tačke, crtice ili donje crte, počevši slovom ili cifrom."

#: lib/ClusterInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: odaberite jedan od navedenih pollera."

#: lib/ClusterInput.php
#, php-format
msgid "Collection Interval: enter whole seconds from %d to %d."
msgstr "Interval prikupljanja: unesite cijele sekunde od %d do %d."

#: lib/ClusterInput.php
msgid "Transport: choose one of the listed transports."
msgstr "Transport: odaberite jedan od navedenih transporta."

#: lib/ClusterInput.php
msgid "slurm.conf: enter an absolute path, or leave it empty to use the poller default."
msgstr "slurm.conf: unesite apsolutnu putanju ili ostavite prazno za podrazumijevanu postavku pollera."

#: lib/ClusterInput.php
msgid "slurmrestd URL: this host and port are not on the slurmrestd host list in Settings."
msgstr "slurmrestd URL: ovaj računar i port nisu na spisku slurmrestd hostova u Postavkama."

#: lib/ClusterInput.php
msgid "slurmrestd URL: enter an https:// URL without user name, query, or fragment; plain http:// is accepted only for a loopback address."
msgstr "slurmrestd URL: unesite https:// URL bez korisničkog imena, upita ili fragmenta; obični http:// je prihvaćen samo za loopback adresu."

#: lib/ClusterInput.php
msgid "slurmrestd User: use at most 64 letters, digits, dots, dashes, or underscores, or leave it empty for a user token."
msgstr "slurmrestd korisnik: koristite najviše 64 slova, cifre, tačke, crtice ili donje crte, ili ostavite prazno za korisnički token."

#: lib/ClusterInput.php
msgid "Token File: enter the absolute path of the token file on the poller. The token itself is never entered here."
msgstr "Datoteka tokena: unesite apsolutnu putanju datoteke tokena na polleru. Sam token se ovdje nikada ne unosi."

#: lib/ClusterInput.php
msgid "Token File: no token file directories are set yet. Ask a Cacti administrator to set them under Settings, HPC Scheduler."
msgstr "Datoteka tokena: direktoriji za datoteke tokena još nisu podešeni. Zamolite Cacti administratora da ih postavi pod Postavke, HPC Scheduler."

#: lib/ClusterInput.php
#, php-format
msgid "Token File: the file must be inside one of the token file directories set in Settings (%s)."
msgstr "Datoteka tokena: datoteka se mora nalaziti unutar jednog od direktorija za datoteke tokena definisanih u Postavkama (%s)."

