msgstr "የHPC መርሐግብር አውጪ ተሰኪ አልነቃም።"

#: setup.php
#, php-format
msgid "The HPC Scheduler plugin requires PHP %s or later."
msgstr "የHPC መርሐግብር አውጪ ተሰኪ PHP %s ወይም ከዚያ በላይ ይፈልጋል።"

#: setup.php
msgid "Management"
msgstr "አስተዳደር"
