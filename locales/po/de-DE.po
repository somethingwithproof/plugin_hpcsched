msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Die HPC-Scheduler-Vorlagen sind nicht installiert. Installieren Sie sie über die Zustandsseite."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Ein Gerät \"%s\" aus der Gerätevorlage %s, abgefragt durch Poller %d, mit deaktivierten Verfügbarkeitsprüfungen."

#: lib/DeviceProvisioner.php
#, php-format
