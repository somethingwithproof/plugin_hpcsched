msgstr "Die Datenabfrage \"%s\", die die derzeit %d bekannten Partitionen indiziert."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d Cluster-Graphen, jeweils mit einer eigenen \"%s\"-Datenquelle."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d Partitionsgraphen, %d für jede Partition, jeweils mit einer eigenen Datenquelle."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Insgesamt: %d Datenquellen und %d RRD-Dateien sowie %d Script-Server-Aufrufe pro Abfragezyklus. Später hinzugefügte Partitionen erhalten Graphen über die Seite „Neue Graphen“."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Vom HPC-Scheduler-Plugin für Cluster %s erstellt. Seine Werte stammen aus dem Plugin-Snapshot; der Hostname ist ein reservierter Name, der niemals kontaktiert wird."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "Konfiguration: Ein Pfad, eine URL oder eine Einstellung fehlt oder ist nicht zulässig"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "der Scheduler konnte nicht erreicht werden"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "der Aufruf dauerte länger als zulässig und wurde abgebrochen"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "die Antwort war größer als zulässig und wurde verworfen"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "die Antwort konnte mit dem festgelegten Datenparser nicht geparst werden"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "der Scheduler hat die Anmeldeinformationen abgelehnt"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "das Scheduler-Konto darf diese Daten nicht einsehen (PrivateData oder Berechtigungen)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "der Controller hat Clients aufgefordert, die Anfragerate zu drosseln (Rate-Limit)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "der Server hat auf eine nicht bedingte Anfrage mit 304 geantwortet; vorherige Daten beibehalten"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "das Plugin hat einen Aufruf außerhalb seiner Allowlist abgelehnt"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "der Aufruf ist fehlgeschlagen"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "dem Reader ist der Arbeitsspeicher ausgegangen; verringern Sie die maximale Antwortgröße oder erhöhen Sie den Erfassungsspeicher in den Einstellungen"

