#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Iitempleyithi ze-HPC Scheduler azifakwanga. Zifake ukusuka kwiphepha lempilo."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Isixhobo \"%s\" esivela kwitempleyithi yesixhobo se-%s, esivavanywa yi-poller %d, uhlolo lokufumaneka luvaliwe."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Umbuzo wedatha \"%s\", ofaka kwisalathisi izahlulelo ezi-%d ezaziwayo ngoku."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Iigrafu zeklasta ezi-%d, nganye inomthombo wayo wedatha othi \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Iigrafu zesahlulelo ezi-%d, ezi-%d kwisahlulelo ngasinye, nganye inomthombo wayo wedatha."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Zonke zizonke: imithombo yedatha eyi-%d kunye neefayile ze-RRD ezi-%d, kunye neekholi ze-script server ezi-%d kuvavanyo ngalunye. Izahlulelo ezongezwa kamva zifumana iigrafu kwiphepha le-New Graphs."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Yenziwe yi-plugin ye-HPC Scheduler yeklasta %s. Amaxabiso ayo avela kwi-snapshot ye-plugin; igama lomamkeli ligama eligciniweyo elingaze liqhagamshelwe."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "uqwalaselo: umendo, i-URL, okanye isetingi ayikho okanye ayivumelekanga"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "umcwangcisi akakwazanga ukufikelelwa"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "ikholi ithathe ixesha elide kunelo elivumelekileyo kwaye imisiwe"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "impendulo yayinkulu kunaleyo ivumelekileyo kwaye ilahliwe"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "impendulo ayikwazanga ukuhlalutywa ngesihlalutyi sedatha esiqhotyoshelweyo"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "umcwangcisi usalile isiqinisekiso"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "iakhawunti yomcwangcisi isenokungayiboni le datha (i-PrivateData okanye iimvume)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "umlawuli ucele abaxhasi ukuba babuye umva (umda wesantya)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "iseva iphendule nge-304 kwisicelo esasingenamqathango; idatha yangaphambili igciniwe"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "i-plugin yalile ikholi engaphandle koluhlu lwayo lwezinto ezivumelekileyo"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "ikholi ayiphumelelanga"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "umfundi uphelelwe yimemori; thoba i-Maximum Answer Size okanye uphakamise i-Collection Memory kwiisetingi"

