#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "El tamaño máximo de respuesta es %d MiB, pero una respuesta decodificada de ese tamaño no cabe en los %d MiB de memoria de recopilación; el lector admite %d MiB. Aumente la memoria o reduzca el tamaño máximo en Ajustes."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Asignado al sondeador %d, un recolector remoto. Esta versión solo recopila en el principal, por lo que no se recopila este clúster; la recopilación remota está prevista para la fase 3. Asígnelo al sondeador principal."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "El intervalo de recopilación es inferior al mínimo de %d segundos."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "El intervalo de recopilación de %d segundos es menor que el del sondeador, de %d segundos; los datos se recopilan cada %d segundos."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "Se accede a slurmrestd mediante HTTP sin cifrar en la dirección de bucle local; el token atraviesa la pila de red local sin cifrado."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Todavía no ha finalizado ninguna ejecución del lector para este clúster."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Archivo de token: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "El token caducó %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "El token caduca en %d minutos."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "La última ejecución agotó su presupuesto de %d segundos; algunas secciones no se recopilaron."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "El planificador informa de Slurm %s, que no es una versión admitida (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "El planificador informa de Slurm %s, que no incluye el analizador de datos %s seleccionado en Ajustes."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Los comandos cliente se ejecutaron sin límite de memoria; configure la ruta de prlimit en Ajustes."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
msgstr "Último error: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "Collection is paused for %d seconds after a rate limit."
msgstr "La recopilación se pausa durante %d segundos tras un límite de frecuencia."

#: lib/HealthWarnings.php
msgid "Data is stale; graphs and alerts read it as unknown."
msgstr "Los datos están obsoletos; los gráficos y las alertas los leen como desconocidos."

