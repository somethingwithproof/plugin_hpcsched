#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Las plantillas de HPC Scheduler no están instaladas. Instálelas desde la página de estado."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Un dispositivo «%s» de la plantilla %s, sondeado por el sondeador %d, con las comprobaciones de disponibilidad desactivadas."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "La consulta de datos «%s», que indexa las %d particiones conocidas actualmente."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d gráficos del clúster, cada uno con su propia fuente de datos «%s»."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d gráficos de particiones, %d por partición, cada uno con su propia fuente de datos."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "En total: %d fuentes de datos y %d archivos RRD, y %d llamadas al servidor de scripts por sondeo. Las particiones añadidas después obtienen sus gráficos desde Nuevos gráficos."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Creado por el complemento HPC Scheduler para el clúster %s. Sus valores proceden de la instantánea del complemento; el nombre de host está reservado y nunca se contacta con él."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configuración: falta una ruta, URL o ajuste, o no está permitido"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "no se pudo contactar con el planificador"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "la llamada superó el tiempo permitido y se detuvo"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "la respuesta superó el tamaño permitido y se descartó"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "no se pudo interpretar la respuesta con el analizador de datos fijado"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "el planificador rechazó la credencial"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "la cuenta del planificador no puede ver estos datos (PrivateData o permisos)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "el controlador pidió a los clientes que esperasen (límite de frecuencia)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "el servidor respondió 304 a una petición no condicional; se conservaron los datos anteriores"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "el complemento rechazó una llamada fuera de su lista permitida"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "la llamada falló"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "el lector se quedó sin memoria; reduzca Tamaño máximo de respuesta o aumente Memoria de recopilación en Ajustes"

