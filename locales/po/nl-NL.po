msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "De HPC Scheduler-sjablonen zijn niet geïnstalleerd. Installeer ze vanaf de statuspagina."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Een apparaat \"%s\" op basis van de apparaatsjabloon %s, gepolld door poller %d, met beschikbaarheidscontroles uitgeschakeld."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "De gegevensquery \"%s\", die de %d nu bekende partities indexeert."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d clustergrafieken, elk met een eigen \"%s\"-gegevensbron."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d partitiegrafieken, %d voor elke partitie, elk met een eigen gegevensbron."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "In totaal: %d gegevensbronnen en %d RRD-bestanden, en %d scriptserver-aanroepen per poll. Later toegevoegde partities krijgen grafieken via de pagina Nieuwe grafieken."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Aangemaakt door de HPC Scheduler-plug-in voor cluster %s. De waarden zijn afkomstig uit de momentopname van de plug-in; de hostnaam is een gereserveerde naam waarmee nooit contact wordt opgenomen."

