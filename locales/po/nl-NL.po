msgid "the answer was larger than allowed and was discarded"
msgstr "het antwoord was groter dan toegestaan en is genegeerd"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "het antwoord kon niet worden geparseerd met de vastgezette gegevensparser"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "de scheduler heeft de referentie geweigerd"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "het scheduler-account mag deze gegevens niet zien (PrivateData of machtigingen)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "de controller heeft clients gevraagd gas terug te nemen (snelheidslimiet)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "de server antwoordde met 304 op een verzoek dat niet voorwaardelijk was; eerdere gegevens behouden"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "de plug-in heeft een aanroep buiten de toelatingslijst geweigerd"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "de aanroep is mislukt"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "de lezer had onvoldoende geheugen; verlaag Maximale antwoordgrootte of verhoog Verzamelgeheugen in Instellingen"

