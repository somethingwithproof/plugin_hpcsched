#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Maximale antwoordgrootte is %d MiB, maar een gedecodeerd antwoord van die grootte past niet in het Verzamelgeheugen van %d MiB; de lezer staat %d MiB toe. Verhoog Verzamelgeheugen of verlaag Maximale antwoordgrootte in Instellingen."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Toegewezen aan poller %d, een externe gegevensverzamelaar. Deze release verzamelt alleen op de hoofdpoller, dus het cluster wordt niet verzameld; extern verzamelen is gepland voor fase 3. Wijs het toe aan de hoofdpoller."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Het verzamelinterval ligt onder de ondergrens van %d seconden."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Het verzamelinterval van %d seconden is korter dan het pollerinterval van %d seconden; gegevens worden elke %d seconden verzameld."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "slurmrestd wordt bereikt via gewone HTTP op het loopback-adres; het token passeert de lokale netwerkstack onversleuteld."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Er is nog geen lezeruitvoering voor dit cluster voltooid."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Tokenbestand: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Het token is %s verlopen."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Het token verloopt over %d minuten."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "De laatste uitvoering heeft het volledige tijdbudget van %d seconden gebruikt; sommige secties zijn niet verzameld."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "De scheduler rapporteert Slurm %s, wat geen ondersteunde release is (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "De scheduler rapporteert Slurm %s, die de in Instellingen gekozen gegevensparser %s niet meelevert."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Clientopdrachten zijn zonder geheugenlimiet uitgevoerd; stel het prlimit-pad in bij Instellingen."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
msgstr "Laatste fout: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "Collection is paused for %d seconds after a rate limit."
msgstr "Verzameling is gedurende %d seconden gepauzeerd na een snelheidslimiet."

#: lib/HealthWarnings.php
msgid "Data is stale; graphs and alerts read it as unknown."
msgstr "Gegevens zijn verouderd; grafieken en waarschuwingen lezen ze als onbekend."

