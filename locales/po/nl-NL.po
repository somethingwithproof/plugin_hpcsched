msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configuratie: een pad, URL of instelling ontbreekt of is niet toegestaan"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "de scheduler kon niet worden bereikt"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "de aanroep duurde langer dan toegestaan en is gestopt"

