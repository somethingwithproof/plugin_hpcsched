#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "O Tamanho máximo da resposta é de %d MiB, mas uma resposta decodificada desse tamanho não cabe na Memória de coleta de %d MiB; o leitor permite %d MiB. Aumente a Memória de coleta ou reduza o Tamanho máximo da resposta em Configurações."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Atribuído ao poller %d, um coletor de dados remoto. Esta versão coleta apenas no poller principal, portanto o cluster não é coletado; a coleta remota está planejada para a fase 3. Atribua-o ao poller principal."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "O intervalo de coleta está abaixo do mínimo de %d segundos."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "O intervalo de coleta de %d segundos é menor que o intervalo do poller de %d segundos; os dados são coletados a cada %d segundos."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "O slurmrestd é acessado via HTTP simples no endereço de loopback; o token atravessa a pilha de rede local sem criptografia."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Nenhuma execução do leitor foi concluída para este cluster ainda."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Arquivo de token: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "O token expirou %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "O token expira em %d minutos."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "A última execução usou todo o seu tempo limite de %d segundos; algumas seções não foram coletadas."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "O agendador relata o Slurm %s, que não é uma versão compatível (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "O agendador relata o Slurm %s, que não inclui o analisador de dados %s escolhido em Configurações."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Os comandos de cliente foram executados sem limite de memória; defina o caminho do prlimit em Configurações."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
msgstr "Último erro: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "Collection is paused for %d seconds after a rate limit."
msgstr "A coleta está pausada por %d segundos após um limite de taxa."

#: lib/HealthWarnings.php
msgid "Data is stale; graphs and alerts read it as unknown."
msgstr "Os dados estão obsoletos; gráficos e alertas os leem como desconhecidos."

