msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d gráficos de cluster, cada um com sua própria fonte de dados \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d gráficos de partição, %d para cada partição, cada um com sua própria fonte de dados."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "No total: %d fontes de dados e %d arquivos RRD, e %d chamadas ao servidor de script por coleta. Partições adicionadas posteriormente recebem gráficos pela página Novos gráficos."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Criado pelo plugin HPC Scheduler para o cluster %s. Seus valores vêm do snapshot do plugin; o nome do host é um nome reservado que nunca é contatado."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configuração: um caminho, URL ou definição está ausente ou não é permitido"

#: lib/ErrorClass.php
