msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Os modelos do HPC Scheduler não estão instalados. Instale-os na página de integridade."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Um dispositivo \"%s\" a partir do modelo de dispositivo %s, consultado pelo poller %d, com verificações de disponibilidade desativadas."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "A consulta de dados \"%s\", indexando as %d partições conhecidas no momento."

#: lib/DeviceProvisioner.php
