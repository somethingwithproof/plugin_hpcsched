#: hpcsched_clusters.php
msgid "You do not have permission for the device of that cluster."
msgstr "Você não tem permissão para o dispositivo desse cluster."

#: hpcsched_clusters.php
msgid "Name: another cluster already uses this name."
msgstr "Nome: outro cluster já usa este nome."

#: hpcsched_clusters.php
msgid "The cluster was not saved: it was changed by someone else since the form was opened, or the write failed. Open it again and repeat the change."
msgstr "O cluster não foi salvo: ele foi alterado por outra pessoa desde que o formulário foi aberto ou a gravação falhou. Abra-o novamente e repita a alteração."

#: hpcsched_clusters.php
msgid "The cluster was saved."
msgstr "O cluster foi salvo."

#: hpcsched_clusters.php
msgid "The cluster state was not changed: the write failed. See the Cacti log."
msgstr "O estado do cluster não foi alterado: a gravação falhou. Consulte o log do Cacti."

#: hpcsched_clusters.php
msgid "The cluster and its cached snapshot were deleted. Its device and graphs were kept. The scheduler was not contacted."
msgstr "O cluster e seu snapshot em cache foram excluídos. Seu dispositivo e gráficos foram mantidos. O agendador não foi contatado."

#: hpcsched_clusters.php
msgid "The device and its graphs were created."
msgstr "O dispositivo e seus gráficos foram criados."

#: hpcsched_clusters.php
msgid "The device was not created: the cluster already has a device, it was changed by someone else since the page was opened, or Cacti refused it. See the Cacti log."
msgstr "O dispositivo não foi criado: o cluster já possui um dispositivo, foi alterado por outra pessoa desde que a página foi aberta ou o Cacti o recusou. Consulte o log do Cacti."

#: hpcsched_clusters.php
msgid "The cluster was mapped to the device."
msgstr "O cluster foi mapeado para o dispositivo."

#: hpcsched_clusters.php
msgid "The cluster was not mapped: the device does not exist, is not allowed to you, already carries another cluster, or the cluster was changed by someone else since the page was opened."
msgstr "O cluster não foi mapeado: o dispositivo não existe, não é permitido para você, já contém outro cluster ou o cluster foi alterado por outra pessoa desde que a página foi aberta."

#: hpcsched_clusters.php
msgid "Missing graphs were added."
msgstr "Os gráficos ausentes foram adicionados."

#: hpcsched_clusters.php
msgid "No graphs were added: the cluster has no device, or its device no longer exists."
msgstr "Nenhum gráfico foi adicionado: o cluster não tem dispositivo ou seu dispositivo não existe mais."

#: hpcsched_clusters.php
msgid "The cluster was not unmapped: it was changed by someone else since the page was opened."
msgstr "O cluster não foi desmapeado: ele foi alterado por outra pessoa desde que a página foi aberta."

#: hpcsched_clusters.php
msgid "The cluster was unmapped. The device and its graphs were kept."
msgstr "O cluster foi desmapeado. O dispositivo e seus gráficos foram mantidos."

#: hpcsched_clusters.php
msgid "The partitions were reindexed from the snapshot."
msgstr "As partições foram reindexadas a partir do snapshot."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the device is disabled or down, so Cacti skipped its data query."
msgstr "As partições não foram reindexadas: o dispositivo está desativado ou inativo, portanto o Cacti ignorou sua consulta de dados."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: Cacti could not run the data query. See the Cacti log."
msgstr "As partições não foram reindexadas: o Cacti não conseguiu executar a consulta de dados. Consulte o log do Cacti."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the HPC Scheduler data query is not installed. Install the templates from the health page."
msgstr "As partições não foram reindexadas: a consulta de dados do HPC Scheduler não está instalada. Instale os modelos na página de integridade."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the cluster has no device, or its device no longer exists."
msgstr "As partições não foram reindexadas: o cluster não tem dispositivo ou seu dispositivo não existe mais."

#: hpcsched_health.php
msgid "The HPC Scheduler templates are installed."
msgstr "Os modelos do HPC Scheduler estão instalados."

#: hpcsched_health.php
#, php-format
msgid "The templates were not installed: %s"
msgstr "Os modelos não foram instalados: %s"

#: hpcsched_operator.php
msgid "Monitoring view"
msgstr "Visão de monitoramento"

#: hpcsched_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Não foi possível ler as observações. Peça a um administrador para verificar o log do plugin."

#: include/operator.php
msgid "Inspect pending reason families and snapshot freshness on the overview. Escalate credentials, cluster mappings and maintenance policy to an administrator."
msgstr "Inspecione as famílias de motivos de pendência e a atualidade do snapshot na visão geral. Encaminhe credenciais, mapeamentos de cluster e política de manutenção a um administrador."

#: lib/ClusterInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nome: use de 1 a 64 letras, dígitos, pontos, hifens ou sublinhados, começando com uma letra ou dígito."

#: lib/ClusterInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: escolha um dos pollers listados."

#: lib/ClusterInput.php
#, php-format
msgid "Collection Interval: enter whole seconds from %d to %d."
msgstr "Intervalo de coleta: informe segundos inteiros de %d a %d."

#: lib/ClusterInput.php
msgid "Transport: choose one of the listed transports."
msgstr "Transporte: escolha um dos transportes listados."

#: lib/ClusterInput.php
msgid "slurm.conf: enter an absolute path, or leave it empty to use the poller default."
msgstr "slurm.conf: informe um caminho absoluto ou deixe em branco para usar o padrão do poller."

#: lib/ClusterInput.php
msgid "slurmrestd URL: this host and port are not on the slurmrestd host list in Settings."
msgstr "URL do slurmrestd: este host e porta não estão na lista de hosts do slurmrestd em Configurações."

#: lib/ClusterInput.php
msgid "slurmrestd URL: enter an https:// URL without user name, query, or fragment; plain http:// is accepted only for a loopback address."
msgstr "URL do slurmrestd: informe uma URL https:// sem nome de usuário, consulta ou fragmento; http:// simples é aceito apenas para um endereço de loopback."

#: lib/ClusterInput.php
msgid "slurmrestd User: use at most 64 letters, digits, dots, dashes, or underscores, or leave it empty for a user token."
msgstr "Usuário do slurmrestd: use no máximo 64 letras, dígitos, pontos, hifens ou sublinhados, ou deixe em branco para um token de usuário."

#: lib/ClusterInput.php
msgid "Token File: enter the absolute path of the token file on the poller. The token itself is never entered here."
msgstr "Arquivo de token: informe o caminho absoluto do arquivo de token no poller. O token em si nunca é inserido aqui."

#: lib/ClusterInput.php
msgid "Token File: no token file directories are set yet. Ask a Cacti administrator to set them under Settings, HPC Scheduler."
msgstr "Arquivo de token: nenhum diretório de arquivo de token foi definido ainda. Peça a um administrador do Cacti para defini-los em Configurações, HPC Scheduler."

#: lib/ClusterInput.php
#, php-format
msgid "Token File: the file must be inside one of the token file directories set in Settings (%s)."
msgstr "Arquivo de token: o arquivo deve estar dentro de um dos diretórios de arquivo de token definidos em Configurações (%s)."

