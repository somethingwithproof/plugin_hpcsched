msgstr "Na'ura \"%s\" daga samfurin na'ura %s, mai tattara bayanai %d ke tattarawa, tare da kashe duba samuwa."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Binciken bayanai \"%s\", yana tsara fihirisar ɓangarori %d da aka sani a yanzu."

