#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Predlošci za HPC Scheduler nisu instalirani. Instalirajte ih sa stranice stanja sustava."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Uređaj \"%s\" iz predloška uređaja %s, pod nadzorom ispitivača %d, s isključenim provjerama dostupnosti."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Upit podataka \"%s\", koji indeksira sada poznatih %d particija."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d grafova klastera, svaki s vlastitim izvorom podataka \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d grafova particija, po %d za svaku particiju, svaki s vlastitim izvorom podataka."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Ukupno: %d izvora podataka i %d RRD datoteka te %d poziva poslužitelja skripti po ispitivanju. Naknadno dodane particije dobivaju grafove sa stranice Novi grafovi."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Stvorio dodatak HPC Scheduler za klaster %s. Njegove vrijednosti potječu iz snimke dodatka; naziv poslužitelja je rezervirano ime koje se nikada ne kontaktira."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "konfiguracija: putanja, URL ili postavka nedostaje ili nije dopuštena"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "nije bilo moguće dosegnuti rasporednik"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "poziv je trajao dulje od dopuštenog i prekinut je"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "odgovor je premašio dopuštenu veličinu i odbačen je"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "odgovor se nije mogao raščlaniti zaključanim analizatorom podataka"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "rasporednik je odbio vjerodajnicu"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "račun rasporednika možda nema uvid u ove podatke (PrivateData ili dopuštenja)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "nadzornik je zatražio od klijenata da odgode zahtjeve (ograničenje stope)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "poslužitelj je odgovorio s 304 na zahtjev koji nije bio uvjetan; zadržani su prethodni podaci"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "dodatak je odbio poziv izvan svog popisa dopuštenih"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "poziv nije uspio"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "čitaču je ponestalo memorije; smanjite Najveću veličinu odgovora ili povećajte Memoriju za prikupljanje u Postavkama"

