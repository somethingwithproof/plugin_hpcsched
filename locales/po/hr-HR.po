#: lib/ClustersPage.php
#, php-format
msgid "The cluster is still mapped to device %d, which no longer exists. Creating or mapping a device replaces that mapping."
msgstr "Klaster je još uvijek pridružen uređaju %d, koji više ne postoji. Stvaranje ili pridruživanje uređaja zamjenjuje to pridruživanje."

#: lib/ClustersPage.php
