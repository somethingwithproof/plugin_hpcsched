#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Najveća veličina odgovora iznosi %d MiB, no dekodirani odgovor te veličine ne stane u Memoriju za prikupljanje od %d MiB; čitač dopušta %d MiB. Povećajte Memoriju za prikupljanje ili smanjite Najveću veličinu odgovora u Postavkama."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Dodijeljeno ispitivaču %d, udaljenom sakupljaču podataka. Ovo izdanje prikuplja podatke samo na glavnom ispitivaču, pa se podaci za klaster ne prikupljaju; udaljeno prikupljanje planirano je za 3. fazu. Dodijelite ga glavnom ispitivaču."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Razdoblje prikupljanja je ispod donjeg praga od %d sekundi."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Razdoblje prikupljanja od %d sekundi kraće je od razdoblja ispitivača od %d sekundi; podaci se prikupljaju svakih %d sekundi."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "Servisu slurmrestd pristupa se običnim HTTP protokolom na povratnoj (loopback) adresi; token prolazi lokalnim mrežnim slogom nekriptiran."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Još nije dovršeno nijedno pokretanje čitača za ovaj klaster."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Datoteka tokena: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Token je istekao %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Token istječe za %d minuta."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "Zadnje pokretanje potrošilo je čitav vremenski okvir od %d sekundi; neki odjeljci nisu prikupljeni."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "Rasporednik javlja Slurm %s, što nije podržano izdanje (%s)."

#: lib/HealthWarnings.php
