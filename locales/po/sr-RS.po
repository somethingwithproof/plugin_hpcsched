#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Шаблони за HPC Scheduler нису инсталирани. Инсталирајте их са странице стања система."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Уређај \"%s\" из шаблона уређаја %s, који испитује poller %d, са искљученим проверама доступности."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Упит података \"%s\", који индексира тренутно познатих %d партиција."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d графикона кластера, сваки са сопственим извором података \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d графикона партиција, по %d за сваку партицију, сваки са сопственим извором података."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Укупно: %d извора података и %d RRD датотека, као и %d позива script сервера по испитивању. Касније додате партиције добијају графиконе са странице Нови графикони."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Креирао додатак HPC Scheduler за кластер %s. Његове вредности потичу из снимка додатка; назив хоста је резервисано име које се никада не контактира."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "конфигурација: путања, URL или подешавање недостаје или није дозвољено"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "није било могуће доћи до планера"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "позив је трајао дуже од дозвољеног и заустављен је"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "одговор је био већи од дозвољеног и одбачен је"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "одговор није могао бити рашчлањен изабраним парсером података"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "планер је одбио акредитив"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "налог планера можда не види ове податке (PrivateData или дозволе)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "контролер је затражио од клијената да успоре (ограничење учесталости)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "сервер је вратио 304 на захтев који није био услован; претходни подаци су задржани"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "додатак је одбио позив ван свог списка дозвољених"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "позив није успео"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "читач је остао без меморије; смањите Максималну величину одговора или повећајте Меморију за прикупљање у Подешавањима"

