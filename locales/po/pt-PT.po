msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Os modelos do Escalonador HPC não estão instalados. Instale-os a partir da página de estado de saúde."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Um dispositivo \"%s\" a partir do modelo de dispositivo %s, sondado pelo poller %d, com as verificações de disponibilidade desativadas."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "A consulta de dados \"%s\", que indexa as %d partições conhecidas atualmente."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d gráficos de cluster, cada um com a sua própria origem de dados \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d gráficos de partição, %d para cada partição, cada um com a sua própria origem de dados."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "No total: %d origens de dados e %d ficheiros RRD, e %d chamadas ao servidor de scripts por sondagem. As partições adicionadas posteriormente obtêm gráficos na página Novos Gráficos."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Criado pelo plugin HPC Scheduler para o cluster %s. Os seus valores provêm do instantâneo do plugin; o nome de anfitrião é um nome reservado que nunca é contactado."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configuração: um caminho, URL ou definição está em falta ou não é permitido"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "não foi possível contactar o escalonador"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "a chamada demorou mais tempo do que o permitido e foi interrompida"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "a resposta foi maior do que o permitido e foi descartada"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "não foi possível analisar a resposta com o analisador de dados fixado"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "o escalonador recusou a credencial"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "a conta do escalonador não pode ver estes dados (PrivateData ou permissões)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "o controlador pediu aos clientes para abrandar (limite de taxa)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "o servidor respondeu 304 a um pedido que não era condicional; dados anteriores mantidos"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "o plugin recusou uma chamada fora da sua lista de permissões"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "a chamada falhou"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "o leitor ficou sem memória; reduza o Tamanho Máximo de Resposta ou aumente a Memória de Recolha nas Definições"

