#: hpcsched_clusters.php
msgid "You do not have permission for the device of that cluster."
msgstr "Não tem permissão para o dispositivo desse cluster."

#: hpcsched_clusters.php
msgid "Name: another cluster already uses this name."
msgstr "Nome: outro cluster já utiliza este nome."

#: hpcsched_clusters.php
msgid "The cluster was not saved: it was changed by someone else since the form was opened, or the write failed. Open it again and repeat the change."
msgstr "O cluster não foi guardado: foi alterado por outra pessoa desde que o formulário foi aberto ou a escrita falhou. Abra-o novamente e repita a alteração."

#: hpcsched_clusters.php
msgid "The cluster was saved."
msgstr "O cluster foi guardado."

#: hpcsched_clusters.php
msgid "The cluster state was not changed: the write failed. See the Cacti log."
msgstr "O estado do cluster não foi alterado: a escrita falhou. Consulte o registo do Cacti."

#: hpcsched_clusters.php
msgid "The cluster and its cached snapshot were deleted. Its device and graphs were kept. The scheduler was not contacted."
msgstr "O cluster e o seu instantâneo em cache foram eliminados. O seu dispositivo e gráficos foram mantidos. O escalonador não foi contactado."

#: hpcsched_clusters.php
msgid "The device and its graphs were created."
msgstr "O dispositivo e os seus gráficos foram criados."

#: hpcsched_clusters.php
msgid "The device was not created: the cluster already has a device, it was changed by someone else since the page was opened, or Cacti refused it. See the Cacti log."
msgstr "O dispositivo não foi criado: o cluster já tem um dispositivo, foi alterado por outra pessoa desde que a página foi aberta ou o Cacti recusou-o. Consulte o registo do Cacti."

#: hpcsched_clusters.php
msgid "The cluster was mapped to the device."
msgstr "O cluster foi associado ao dispositivo."

#: hpcsched_clusters.php
msgid "The cluster was not mapped: the device does not exist, is not allowed to you, already carries another cluster, or the cluster was changed by someone else since the page was opened."
msgstr "O cluster não foi associado: o dispositivo não existe, não lhe está autorizado, já tem outro cluster ou o cluster foi alterado por outra pessoa desde que a página foi aberta."

#: hpcsched_clusters.php
msgid "Missing graphs were added."
msgstr "Os gráficos em falta foram adicionados."

#: hpcsched_clusters.php
msgid "No graphs were added: the cluster has no device, or its device no longer exists."
msgstr "Nenhum gráfico foi adicionado: o cluster não tem dispositivo ou o respetivo dispositivo já não existe."

#: hpcsched_clusters.php
msgid "The cluster was not unmapped: it was changed by someone else since the page was opened."
msgstr "O cluster não foi desassociado: foi alterado por outra pessoa desde que a página foi aberta."

#: hpcsched_clusters.php
msgid "The cluster was unmapped. The device and its graphs were kept."
msgstr "O cluster foi desassociado. O dispositivo e os seus gráficos foram mantidos."

#: hpcsched_clusters.php
msgid "The partitions were reindexed from the snapshot."
msgstr "As partições foram reindexadas a partir do instantâneo."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the device is disabled or down, so Cacti skipped its data query."
msgstr "As partições não foram reindexadas: o dispositivo está desativado ou inativo, pelo que o Cacti ignorou a respetiva consulta de dados."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: Cacti could not run the data query. See the Cacti log."
msgstr "As partições não foram reindexadas: o Cacti não conseguiu executar a consulta de dados. Consulte o registo do Cacti."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the HPC Scheduler data query is not installed. Install the templates from the health page."
msgstr "As partições não foram reindexadas: a consulta de dados do Escalonador HPC não está instalada. Instale os modelos a partir da página de estado de saúde."

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the cluster has no device, or its device no longer exists."
msgstr "As partições não foram reindexadas: o cluster não tem dispositivo ou o respetivo dispositivo já não existe."

#: hpcsched_health.php
msgid "The HPC Scheduler templates are installed."
msgstr "Os modelos do Escalonador HPC estão instalados."

#: hpcsched_health.php
#, php-format
msgid "The templates were not installed: %s"
msgstr "Os modelos não foram instalados: %s"

#: hpcsched_operator.php
msgid "Monitoring view"
msgstr "Vista de monitorização"

#: hpcsched_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Não foi possível ler as observações. Peça a um administrador para verificar o registo do plugin."

#: include/operator.php
msgid "Inspect pending reason families and snapshot freshness on the overview. Escalate credentials, cluster mappings and maintenance policy to an administrator."
msgstr "Inspecione as famílias de motivos de pendência e a atualidade dos instantâneos na vista geral. Encaminhe credenciais, associações de clusters e políticas de manutenção para um administrador."

#: lib/ClusterInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nome: utilize de 1 a 64 letras, dígitos, pontos, hífenes ou sublinhados, começando por uma letra ou um dígito."

#: lib/ClusterInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: escolha um dos pollers listados."

#: lib/ClusterInput.php
#, php-format
msgid "Collection Interval: enter whole seconds from %d to %d."
msgstr "Intervalo de recolha: introduza segundos inteiros de %d a %d."

#: lib/ClusterInput.php
msgid "Transport: choose one of the listed transports."
msgstr "Transporte: escolha um dos transportes listados."

#: lib/ClusterInput.php
msgid "slurm.conf: enter an absolute path, or leave it empty to use the poller default."
msgstr "slurm.conf: introduza um caminho absoluto ou deixe em branco para utilizar a predefinição do poller."

#: lib/ClusterInput.php
msgid "slurmrestd URL: this host and port are not on the slurmrestd host list in Settings."
msgstr "URL do slurmrestd: este anfitrião e porta não constam na lista de anfitriões do slurmrestd nas Definições."

#: lib/ClusterInput.php
msgid "slurmrestd URL: enter an https:// URL without user name, query, or fragment; plain http:// is accepted only for a loopback address."
msgstr "URL do slurmrestd: introduza um URL https:// sem nome de utilizador, consulta nem fragmento; http:// simples só é aceite para um endereço de loopback."

#: lib/ClusterInput.php
msgid "slurmrestd User: use at most 64 letters, digits, dots, dashes, or underscores, or leave it empty for a user token."
msgstr "Utilizador do slurmrestd: utilize, no máximo, 64 letras, dígitos, pontos, hífenes ou sublinhados, ou deixe em branco para um token de utilizador."

#: lib/ClusterInput.php
msgid "Token File: enter the absolute path of the token file on the poller. The token itself is never entered here."
msgstr "Ficheiro de token: introduza o caminho absoluto do ficheiro de token no poller. O token em si nunca é introduzido aqui."

#: lib/ClusterInput.php
msgid "Token File: no token file directories are set yet. Ask a Cacti administrator to set them under Settings, HPC Scheduler."
msgstr "Ficheiro de token: ainda não foram definidos diretórios de ficheiros de token. Peça a um administrador do Cacti para os definir em Definições, Escalonador HPC."

#: lib/ClusterInput.php
#, php-format
msgid "Token File: the file must be inside one of the token file directories set in Settings (%s)."
msgstr "Ficheiro de token: o ficheiro tem de estar dentro de um dos diretórios de ficheiros de token definidos nas Definições (%s)."

