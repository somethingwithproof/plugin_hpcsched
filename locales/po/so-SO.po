#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Qaab-dhismeedyada HPC Scheduler lama rakibin. Ka rakib bogga caafimaadka."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Aalad \"%s\" oo ka timid qaab-dhismeedka aaladda %s, oo uu ururiyo poller %d, iyadoo hubinta helitaanku dansan tahay."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Weydiinta xogta \"%s\", oo tusmaynaysa %d qaybood ee hadda la yaqaan."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d garaafyo kooxeed, mid walba wuxuu leeyahay ishiisa xogta \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d garaafyo qaybeed, %d qayb kasta, mid walba wuxuu leeyahay ishiisa xogta."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Guud ahaan: %d ilo xog ah iyo %d faylal RRD ah, iyo %d wicitaanada adeegaha qoraalka ururin kasta. Qaybaha hadhow lagu daro waxay ka helayaan garaafyo bogga Garaafyada Cusub."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Waxaa abuuray barnaamij-ku-darka HPC Scheduler ee kooxda %s. Qiimayaashiisu waxay ka yimaadaan sawirka kaydsan ee barnaamij-ku-darka; magaca martigeliyuhu waa magac kaydsan oo aan marnaba lala xiriirin."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "qaabeynta: jid, URL, ama dejin ayaa maqan ama aan la oggolayn"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "jadwal-sameeyaha lama gaari karin"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "wicitaanku wuxuu qaatay waqti ka badan inta la oggol yahay waana la joojiyay"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "jawaabtu waxay ka weyneyd inta la oggol yahay waana la tuuray"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "jawaabta laguma falanqeyn karin falanqeeyaha xogta ee ku xiran"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "jadwal-sameeyuhu wuu diiday aqoonsiga"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "koontada jadwal-sameeyaha ma arki karto xogtan (PrivateData ama ogolaansho)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "maamuluhu wuxuu ka codsaday macaamiisha inay dib u joogsadaan (xaddidka xawaaraha)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "adeeguhu wuxuu kaga jawaabay 304 codsi aan shuruud lahayn; xogtii hore waa la hayay"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "barnaamij-ku-darku wuu diiday wicitaan ka baxsan liiska oggolaanshahiisa"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "wicitaankii wuu fashilmay"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "akhriska xasuusta ayaa ka dhammaatay; hoos u dhig Cabirka Ugu Badan ee Jawaabta ama kordhi Xasuusta Ururinta ee Dejinta"

