#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Maximal svarsstorlek är %d MiB, men ett avkodat svar av den storleken får inte plats i insamlingsminnet på %d MiB; läsaren tillåter %d MiB. Höj Insamlingsminne eller sänk Maximal svarsstorlek i Inställningar."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Tilldelad poller %d, en fjärrdatainsamlare. Denna version samlar endast in på huvudpollern, så klustret samlas inte in; fjärrinsamling är planerad till fas 3. Tilldela det till huvudpollern."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Insamlingsintervallet understiger gränsen på %d sekunder."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Insamlingsintervallet på %d sekunder är kortare än pollerintervallet på %d sekunder; data samlas in var %d sekund."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "slurmrestd nås över vanlig HTTP på loopback-adressen; token passerar den lokala nätverksstacken okrypterad."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Ingen läsarkörning har slutförts för detta kluster ännu."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Tokenfil: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Token löpte ut %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Token löper ut om %d minuter."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "Den senaste körningen använde hela sin tidsbudget på %d sekunder; vissa avsnitt samlades inte in."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "Schemaläggaren rapporterar Slurm %s, vilket inte är en version som stöds (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "Schemaläggaren rapporterar Slurm %s, som inte levereras med den datatolk %s som valts i Inställningar."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Klientkommandon kördes utan minnesgräns; ange sökvägen till prlimit i Inställningar."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
msgstr "Senaste fel: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "Collection is paused for %d seconds after a rate limit."
msgstr "Insamlingen är pausad i %d sekunder efter en hastighetsbegränsning."

#: lib/HealthWarnings.php
msgid "Data is stale; graphs and alerts read it as unknown."
msgstr "Data är inaktuell; grafer och larm läser den som okänd."

