msgstr "schemaläggarkontot får kanske inte se denna data (PrivateData eller behörigheter)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "styrenheten bad klienterna att avvakta (hastighetsbegränsning)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "servern svarade 304 på en begäran som inte var villkorad; tidigare data behölls"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "insticksprogrammet nekade ett anrop utanför sin tillåtelselista"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "anropet misslyckades"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "läsaren fick slut på minne; sänk Maximal svarsstorlek eller höj Insamlingsminne i Inställningar"

