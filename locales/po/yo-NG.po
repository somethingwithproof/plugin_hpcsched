msgstr "So Ẹ̀rọ Pọ̀"

#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "A kò fi àwọn àwòkọ HPC Scheduler sórí ẹ̀rọ. Fi wọ́n sórí ẹ̀rọ láti ojú-ewé ìlera."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Ẹ̀rọ \"%s\" láti inú àwòkọ ẹ̀rọ %s, tí olùkójọ %d ń kójọ, pẹ̀lú àyẹ̀wò wíwà ní àìṣiṣẹ́."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Ìbéèrè dátà \"%s\", tí ó ń kọ àwọn ìpín %d tí a mọ̀ báyìí sínú àtọ́ka."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Àwọn àwòrán ìṣirò kúlọ́sítà %d, ọ̀kọ̀ọ̀kan pẹ̀lú orísun dátà \"%s\" tirẹ̀."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Àwọn àwòrán ìṣirò ìpín %d, %d fún ìpín kọ̀ọ̀kan, ọ̀kọ̀ọ̀kan pẹ̀lú orísun dátà tirẹ̀."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Ní gbogbo rẹ̀: àwọn orísun dátà %d àti àwọn fáìlì RRD %d, àti àwọn ìpè olùpèsè ìwé-àṣẹ %d fún ìkójọpọ̀ kọ̀ọ̀kan. Àwọn ìpín tí a fi kún un lẹ́yìn-ọ̀-rẹyìn ń gba àwọn àwòrán ìṣirò láti ojú-ewé New Graphs."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Tí àfikún HPC Scheduler ṣẹ̀dá fún kúlọ́sítà %s. Àwọn iye rẹ̀ wá láti inú àwòrán àkókò àfikún náà; orúkọ olùgbàlejò jẹ́ orúkọ ìfipamọ́ tí a kì í kàn sí rárá."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "ìṣètò: ipa-ọ̀nà kan, URL, tàbí ètò kan sọnù tàbí a kò gbà á láàyè"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "a kò lè dé ọ̀dọ̀ olùṣètò àkókò náà"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "ìpè náà gba àkókò púpọ̀ ju bí a ti gbà láàyè lọ, a sì dá a dúró"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "ìdáhùn náà tóbi ju bí a ti gbà láàyè lọ, a sì kọ̀ ọ́ nù"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "a kò lè tú ìdáhùn náà pẹ̀lú olùtú dátà tí a so mọ́"

