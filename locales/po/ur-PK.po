#: hpcsched_clusters.php
msgid "You do not have permission for the device of that cluster."
msgstr "آپ کو اس کلسٹر کی ڈیوائس تک رسائی کی اجازت نہیں ہے۔"

#: hpcsched_clusters.php
msgid "Name: another cluster already uses this name."
msgstr "نام: ایک اور کلسٹر پہلے ہی یہ نام استعمال کر رہا ہے۔"

#: hpcsched_clusters.php
msgid "The cluster was not saved: it was changed by someone else since the form was opened, or the write failed. Open it again and repeat the change."
msgstr "کلسٹر محفوظ نہیں ہوا: فارم کھلنے کے بعد کسی اور نے اس میں تبدیلی کر دی تھی، یا لکھنے کا عمل ناکام ہو گیا۔ اسے دوبارہ کھولیں اور تبدیلی دہرائیں۔"

#: hpcsched_clusters.php
msgid "The cluster was saved."
msgstr "کلسٹر محفوظ ہو گیا۔"

#: hpcsched_clusters.php
msgid "The cluster state was not changed: the write failed. See the Cacti log."
msgstr "کلسٹر کی حالت تبدیل نہیں ہوئی: لکھنے کا عمل ناکام ہو گیا۔ Cacti لاگ دیکھیں۔"

#: hpcsched_clusters.php
msgid "The cluster and its cached snapshot were deleted. Its device and graphs were kept. The scheduler was not contacted."
msgstr "کلسٹر اور اس کا کیش شدہ اسنیپ شاٹ حذف کر دیے گئے۔ اس کی ڈیوائس اور گرافس محفوظ رکھے گئے۔ شیڈولر سے رابطہ نہیں کیا گیا۔"

#: hpcsched_clusters.php
msgid "The device and its graphs were created."
msgstr "ڈیوائس اور اس کے گرافس بنا دیے گئے۔"

#: hpcsched_clusters.php
msgid "The device was not created: the cluster already has a device, it was changed by someone else since the page was opened, or Cacti refused it. See the Cacti log."
msgstr "ڈیوائس نہیں بنائی گئی: کلسٹر کے پاس پہلے ہی ایک ڈیوائس موجود ہے، صفحہ کھلنے کے بعد کسی اور نے اس میں تبدیلی کر دی تھی، یا Cacti نے اسے مسترد کر دیا۔ Cacti لاگ دیکھیں۔"

#: hpcsched_clusters.php
msgid "The cluster was mapped to the device."
msgstr "کلسٹر کو ڈیوائس سے میپ کر دیا گیا۔"

#: hpcsched_clusters.php
msgid "The cluster was not mapped: the device does not exist, is not allowed to you, already carries another cluster, or the cluster was changed by someone else since the page was opened."
msgstr "کلسٹر میپ نہیں ہوا: ڈیوائس موجود نہیں ہے، آپ کو اس کی اجازت نہیں ہے، اس پر پہلے ہی کوئی اور کلسٹر موجود ہے، یا صفحہ کھلنے کے بعد کسی اور نے کلسٹر میں تبدیلی کر دی تھی۔"

#: hpcsched_clusters.php
msgid "Missing graphs were added."
msgstr "غائب گرافس شامل کر دیے گئے۔"

#: hpcsched_clusters.php
msgid "No graphs were added: the cluster has no device, or its device no longer exists."
msgstr "کوئی گراف شامل نہیں کیا گیا: کلسٹر کے پاس کوئی ڈیوائس نہیں ہے، یا اس کی ڈیوائس اب موجود نہیں ہے۔"

#: hpcsched_clusters.php
msgid "The cluster was not unmapped: it was changed by someone else since the page was opened."
msgstr "کلسٹر اَن میپ نہیں ہوا: صفحہ کھلنے کے بعد کسی اور نے اس میں تبدیلی کر دی تھی۔"

#: hpcsched_clusters.php
msgid "The cluster was unmapped. The device and its graphs were kept."
msgstr "کلسٹر اَن میپ ہو گیا۔ ڈیوائس اور اس کے گرافس محفوظ رکھے گئے۔"

#: hpcsched_clusters.php
msgid "The partitions were reindexed from the snapshot."
msgstr "پارٹیشنز کو اسنیپ شاٹ سے دوبارہ انڈیکس کر دیا گیا۔"

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the device is disabled or down, so Cacti skipped its data query."
msgstr "پارٹیشنز کو دوبارہ انڈیکس نہیں کیا گیا: ڈیوائس غیر فعال یا ڈاؤن (ناقابلِ رسائی) ہے، اس لیے Cacti نے اس کی ڈیٹا کوئری چھوڑ دی۔"

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: Cacti could not run the data query. See the Cacti log."
msgstr "پارٹیشنز کو دوبارہ انڈیکس نہیں کیا گیا: Cacti ڈیٹا کوئری نہیں چلا سکا۔ Cacti لاگ دیکھیں۔"

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the HPC Scheduler data query is not installed. Install the templates from the health page."
msgstr "پارٹیشنز کو دوبارہ انڈیکس نہیں کیا گیا: HPC Scheduler ڈیٹا کوئری انسٹال نہیں ہے۔ ہیلتھ صفحے سے ٹیمپلیٹس انسٹال کریں۔"

#: hpcsched_clusters.php
msgid "The partitions were not reindexed: the cluster has no device, or its device no longer exists."
msgstr "پارٹیشنز کو دوبارہ انڈیکس نہیں کیا گیا: کلسٹر کے پاس کوئی ڈیوائس نہیں ہے، یا اس کی ڈیوائس اب موجود نہیں ہے۔"

#: hpcsched_health.php
msgid "The HPC Scheduler templates are installed."
msgstr "HPC Scheduler ٹیمپلیٹس انسٹال ہیں۔"

#: hpcsched_health.php
#, php-format
msgid "The templates were not installed: %s"
msgstr "ٹیمپلیٹس انسٹال نہیں ہوئے: %s"

#: hpcsched_operator.php
msgid "Monitoring view"
msgstr "مانیٹرنگ منظر"

#: hpcsched_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "مشاہدات پڑھے نہیں جا سکے۔ ایڈمنسٹریٹر سے پلگ ان لاگ چیک کرنے کو کہیں۔"

#: include/operator.php
msgid "Inspect pending reason families and snapshot freshness on the overview. Escalate credentials, cluster mappings and maintenance policy to an administrator."
msgstr "جائزہ صفحے پر زیرِ التوا وجوہات کے گروپس اور اسنیپ شاٹ کی تازگی کا معائنہ کریں۔ اسناد، کلسٹر میپنگز اور مینٹیننس پالیسی کے معاملات ایڈمنسٹریٹر تک پہنچائیں۔"

#: lib/ClusterInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "نام: کسی حرف یا ہندسے سے شروع کرتے ہوئے 1 سے 64 حروف، ہندسے، نقطے، ڈیش، یا انڈراسکور استعمال کریں۔"

#: lib/ClusterInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "پولر: فہرست میں دیے گئے پولرز میں سے ایک منتخب کریں۔"

#: lib/ClusterInput.php
#, php-format
msgid "Collection Interval: enter whole seconds from %d to %d."
msgstr "کلیکشن کا وقفہ: %d سے %d تک مکمل سیکنڈز درج کریں۔"

#: lib/ClusterInput.php
msgid "Transport: choose one of the listed transports."
msgstr "ٹرانسپورٹ: درج کردہ ٹرانسپورٹس میں سے کوئی ایک منتخب کریں۔"

#: lib/ClusterInput.php
msgid "slurm.conf: enter an absolute path, or leave it empty to use the poller default."
msgstr "slurm.conf: ایک مکمل (absolute) راستہ درج کریں، یا پولر کی ڈیفالٹ قدر استعمال کرنے کے لیے اسے خالی چھوڑ دیں۔"

#: lib/ClusterInput.php
msgid "slurmrestd URL: this host and port are not on the slurmrestd host list in Settings."
msgstr "slurmrestd URL: یہ ہوسٹ اور پورٹ ترتیبات میں موجود slurmrestd ہوسٹ فہرست میں شامل نہیں ہیں۔"

#: lib/ClusterInput.php
msgid "slurmrestd URL: enter an https:// URL without user name, query, or fragment; plain http:// is accepted only for a loopback address."
msgstr "slurmrestd URL: صارف کے نام، کوئری، یا فریگمنٹ کے بغیر https:// URL درج کریں؛ سادہ http:// صرف لوپ بیک ایڈریس کے لیے قبول کیا جاتا ہے۔"

#: lib/ClusterInput.php
msgid "slurmrestd User: use at most 64 letters, digits, dots, dashes, or underscores, or leave it empty for a user token."
msgstr "slurmrestd صارف: زیادہ سے زیادہ 64 حروف، ہندسے، نقطے، ڈیش، یا انڈراسکور استعمال کریں، یا یوزر ٹوکن کے لیے اسے خالی چھوڑ دیں۔"

#: lib/ClusterInput.php
msgid "Token File: enter the absolute path of the token file on the poller. The token itself is never entered here."
msgstr "ٹوکن فائل: پولر پر ٹوکن فائل کا مکمل (absolute) راستہ درج کریں۔ ٹوکن بذاتِ خود یہاں کبھی درج نہیں کیا جاتا۔"

#: lib/ClusterInput.php
msgid "Token File: no token file directories are set yet. Ask a Cacti administrator to set them under Settings, HPC Scheduler."
msgstr "ٹوکن فائل: ابھی تک کوئی ٹوکن فائل ڈائریکٹریز مقرر نہیں کی گئیں۔ Cacti ایڈمنسٹریٹر سے کہیں کہ وہ انہیں ترتیبات، HPC Scheduler کے تحت مقرر کرے۔"

#: lib/ClusterInput.php
#, php-format
msgid "Token File: the file must be inside one of the token file directories set in Settings (%s)."
msgstr "ٹوکن فائل: فائل ترتیبات (%s) میں مقرر کردہ ٹوکن فائل ڈائریکٹریز میں سے کسی ایک کے اندر ہونی چاہیے۔"

