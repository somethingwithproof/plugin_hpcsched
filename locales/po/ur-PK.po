msgstr "پولر پر ٹوکن فائل"

#: lib/ClustersPage.php
msgid "Client commands use the binaries set under Settings > HPC Scheduler and the poller user's own Slurm authentication; the optional slurm.conf path selects a cluster. slurmrestd fields are used only with that transport. The token file must be readable by the poller user only; the plugin reads it at each run and never stores the token."
msgstr "کلائنٹ کمانڈز ترتیبات > HPC Scheduler کے تحت مقرر کردہ بائنریز اور پولر صارف کی اپنی Slurm توثیق استعمال کرتی ہیں؛ اختیاری slurm.conf راستہ کلسٹر منتخب کرتا ہے۔ slurmrestd فیلڈز صرف اسی ٹرانسپورٹ کے ساتھ استعمال ہوتی ہیں۔ ٹوکن فائل صرف پولر صارف کے لیے قابلِ مطالعہ ہونی چاہیے؛ پلگ ان اسے ہر بار چلتے وقت پڑھتا ہے اور کبھی ٹوکن محفوظ نہیں کرتا۔"

#: lib/ClustersPage.php
msgid "Save"
msgstr "محفوظ کریں"

#: lib/ClustersPage.php
#, php-format
msgid "Device for Cluster: %s"
msgstr "کلسٹر کے لیے ڈیوائس: %s"

#: lib/ClustersPage.php
#, php-format
msgid "Mapped to device %s (id %d). Its graphs follow Cacti's device and graph permissions."
msgstr "ڈیوائس %s (id %d) سے میپ کیا گیا۔ اس کے گرافس Cacti کی ڈیوائس اور گراف اجازتوں کی پیروی کرتے ہیں۔"

#: lib/ClustersPage.php
msgid "Adding the missing graphs adds:"
msgstr "غائب گرافس شامل کرنے سے یہ شامل ہوں گے:"

#: lib/ClustersPage.php
msgid "Add Missing Graphs"
msgstr "غائب گرافس شامل کریں"

#: lib/ClustersPage.php
msgid "Reindex Partitions"
msgstr "پارٹیشنز دوبارہ انڈیکس کریں"

#: lib/ClustersPage.php
msgid "Unmap"
msgstr "اَن میپ کریں"

#: lib/ClustersPage.php
msgid "Unmapping keeps the device, its graphs, and their history."
msgstr "اَن میپ کرنے سے ڈیوائس، اس کے گرافس، اور ان کی تاریخ محفوظ رہتی ہے۔"

#: lib/ClustersPage.php
#, php-format
msgid "The cluster is still mapped to device %d, which no longer exists. Creating or mapping a device replaces that mapping."
msgstr "کلسٹر اب بھی ڈیوائس %d سے میپ ہے، جو اب موجود نہیں ہے۔ نئی ڈیوائس بنانے یا میپ کرنے سے یہ میپنگ تبدیل ہو جائے گی۔"

#: lib/ClustersPage.php
msgid "Creating a device adds:"
msgstr "ڈیوائس بنانے سے یہ شامل ہوں گے:"

#: lib/ClustersPage.php
msgid "Without partition graphs, only the cluster graphs are created, and the data sources and calls for the partitions above are left out."
msgstr "پارٹیشن گرافس کے بغیر، صرف کلسٹر گرافس بنائے جاتے ہیں، اور اوپر دیے گئے پارٹیشنز کے لیے ڈیٹا سورسز اور کالز چھوڑ دی جاتی ہیں۔"

#: lib/ClustersPage.php
msgid "Also create the partition graphs"
msgstr "پارٹیشن گرافس بھی بنائیں"

#: lib/ClustersPage.php
msgid "Create Device"
msgstr "ڈیوائس بنائیں"

#: lib/ClustersPage.php
msgid "Or map an existing device"
msgstr "یا موجودہ ڈیوائس میپ کریں"

#: lib/ClustersPage.php
msgid "Map Device"
msgstr "ڈیوائس میپ کریں"

#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "HPC Scheduler ٹیمپلیٹس انسٹال نہیں ہیں۔ ہیلتھ صفحے سے انہیں انسٹال کریں۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "ایک ڈیوائس \"%s\" جو %s ڈیوائس ٹیمپلیٹ سے ہے، پولر %d کے ذریعے پول کی جاتی ہے، دستیابی کی جانچ بند ہے۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "ڈیٹا کوئری \"%s\"، جو ابھی معلوم %d پارٹیشنز کو انڈیکس کر رہی ہے۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d کلسٹر گرافس، ہر ایک اپنے \"%s\" ڈیٹا سورس کے ساتھ۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d پارٹیشن گرافس، ہر پارٹیشن کے لیے %d، ہر ایک اپنے ڈیٹا سورس کے ساتھ۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "مجموعی طور پر: %d ڈیٹا سورسز اور %d RRD فائلیں، اور فی پول %d اسکرپٹ سرور کالز۔ بعد میں شامل کیے گئے پارٹیشنز کو نئے گرافس کے صفحے سے گرافس ملتے ہیں۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "کلسٹر %s کے لیے HPC Scheduler پلگ ان کے ذریعے بنائی گئی۔ اس کی قدریں پلگ ان اسنیپ شاٹ سے آتی ہیں؛ ہوسٹ نام ایک مخصوص نام ہے جس سے کبھی رابطہ نہیں کیا جاتا۔"

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "کنفیگریشن: کوئی راستہ، URL، یا ترتیب غائب ہے یا اس کی اجازت نہیں ہے"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
