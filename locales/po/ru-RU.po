msgstr "Сопоставить устройство"

#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Шаблоны HPC Scheduler не установлены. Установите их со страницы состояния."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Устройство «%s» по шаблону устройства %s, опрашиваемое поллером %d, с отключёнными проверками доступности."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Запрос данных «%s», индексирующий %d известных на данный момент разделов."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d графиков кластера, каждый со своим источником данных «%s»."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d графиков разделов, по %d для каждого раздела, каждый со своим источником данных."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Всего: %d источников данных, %d файлов RRD и %d вызовов сервера скриптов за один опрос. Для разделов, добавленных позже, графики создаются на странице «Новые графики»."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Создано плагином HPC Scheduler для кластера %s. Его значения поступают из снимка плагина; имя узла является зарезервированным именем, к которому никогда не выполняется обращение."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "конфигурация: путь, URL или параметр отсутствует либо не разрешён"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "не удалось связаться с планировщиком"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "вызов выполнялся дольше допустимого времени и был остановлен"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "ответ превысил допустимый размер и был отброшен"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "не удалось разобрать ответ с помощью закреплённого парсера данных"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "планировщик отклонил учётные данные"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "учётная запись планировщика не имеет доступа к этим данным (PrivateData или разрешения)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "контроллер попросил клиентов снизить частоту запросов (ограничение скорости)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "сервер ответил кодом 304 на запрос, который не был условным; предыдущие данные сохранены"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "плагин отклонил вызов вне списка разрешённых"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "вызов завершился ошибкой"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "средству чтения не хватило памяти; уменьшите «Максимальный размер ответа» или увеличьте «Память для сбора данных» в настройках"

