msgid "readable only by the poller user"
msgstr "доступен для чтения только пользователю поллера"

#: lib/TokenState.php
msgid "readable by the file group; restrict it to the poller user (chmod 600)"
msgstr "доступен для чтения группе файла; ограничьте доступ только пользователем поллера (chmod 600)"

#: lib/TokenState.php
msgid "readable by every user on the poller; restrict it to the poller user (chmod 600)"
msgstr "доступен для чтения любому пользователю на поллере; ограничьте доступ только пользователем поллера (chmod 600)"

#: lib/TokenState.php
msgid "refused: owned by a user other than the poller user (chown it to the poller user)"
msgstr "отклонён: владельцем является пользователь, отличный от пользователя поллера (выполните chown на пользователя поллера)"

#: lib/TokenState.php
msgid "missing or not readable by the poller user"
msgstr "отсутствует или недоступен для чтения пользователю поллера"

#: lib/TokenState.php
msgid "refused: outside the token file directories set in Settings, reached through a symbolic link, not a regular file, writable by others, or too large; the log names the reason"
msgstr "отклонён: находится вне каталогов файлов токенов, указанных в настройках, доступен через символическую ссылку, не является обычным файлом, доступен для записи другим пользователям или слишком велик; причина указана в журнале"

