#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "قوالب HPC Scheduler غير مثبّتة. ثبّتها من صفحة الحالة الصحية."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "جهاز \"%s\" من قالب الجهاز %s، يتم استطلاعه بواسطة المستطلع %d، مع إيقاف فحوصات التوافر."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "استعلام البيانات \"%s\"، يفهرس %d من الأقسام المعروفة حاليًا."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d من الرسوم البيانية للعنقود، لكل منها مصدر البيانات \"%s\" الخاص به."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d من الرسوم البيانية للأقسام، بمعدل %d لكل قسم، ولكل منها مصدر البيانات الخاص به."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "في المجموع: %d من مصادر البيانات و%d من ملفات RRD، و%d من استدعاءات خادم السكربتات لكل استطلاع. تحصل الأقسام المضافة لاحقًا على رسوم بيانية من صفحة الرسوم البيانية الجديدة."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "تم إنشاؤه بواسطة إضافة HPC Scheduler للعنقود %s. تأتي قيمه من لقطة الإضافة؛ اسم المضيف هو اسم محجوز لا يتم الاتصال به أبدًا."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "التكوين: مسار أو عنوان URL أو إعداد مفقود أو غير مسموح به"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "تعذّر الوصول إلى المُجدول"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "استغرق الاستدعاء وقتًا أطول من المسموح به وتم إيقافه"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "كان الرد أكبر من المسموح به وتم تجاهله"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "تعذّر تحليل الرد باستخدام محلل البيانات المثبّت"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "رفض المُجدول بيانات الاعتماد"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "قد لا يُسمح لحساب المُجدول برؤية هذه البيانات (PrivateData أو الصلاحيات)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "طلب المتحكم من العملاء التراجع مؤقتًا (حد المعدل)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "أجاب الخادم بالرمز 304 على طلب لم يكن مشروطًا؛ تم الاحتفاظ بالبيانات السابقة"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "رفضت الإضافة استدعاءً خارج قائمة السماح الخاصة بها"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "فشل الاستدعاء"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "نفدت ذاكرة القارئ؛ خفّض الحد الأقصى لحجم الرد أو ارفع ذاكرة الجمع في الإعدادات"

