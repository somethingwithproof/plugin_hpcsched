#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Maksimum Antwoordgrootte is %d MiB, maar 'n gedekodeerde antwoord van daardie grootte pas nie in die Insamelingsgeheue van %d MiB nie; die leser laat %d MiB toe. Verhoog Insamelingsgeheue of verlaag Maksimum Antwoordgrootte in Opstelling."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Toegewys aan poller %d, 'n afgeleë data-insamelaar. Hierdie vrystelling samel slegs op die hoofpoller in, dus word die kluster nie ingesamel nie; afgeleë insameling word vir fase 3 beplan. Wys dit aan die hoofpoller toe."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Die insamelingsinterval is onder die minimum van %d sekondes."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Die insamelingsinterval van %d sekondes is korter as die poller-interval van %d sekondes; data word elke %d sekondes ingesamel."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "slurmrestd word oor gewone HTTP op die teruglusadres bereik; die token gaan ongeënkripteer oor die plaaslike netwerkstapel."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Geen leseruitvoering het nog vir hierdie kluster voltooi nie."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Tokenlêer: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Die token het %s verval."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Die token verval oor %d minute."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "Die laaste uitvoering het sy hele tydsbegroting van %d sekondes gebruik; sommige afdelings is nie ingesamel nie."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "Die skeduleerder rapporteer Slurm %s, wat nie 'n ondersteunde vrystelling is nie (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "Die skeduleerder rapporteer Slurm %s, wat nie die data-ontleder %s bevat wat in Opstelling gekies is nie."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Kliëntopdragte het sonder 'n geheuebeperking geloop; stel die prlimit-pad in Opstelling."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
msgstr "Laaste fout: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "Collection is paused for %d seconds after a rate limit."
msgstr "Insameling is vir %d sekondes gepouseer na 'n tempobeperking."

#: lib/HealthWarnings.php
msgid "Data is stale; graphs and alerts read it as unknown."
msgstr "Data is verouderd; grafieke en waarskuwings lees dit as onbekend."

#: lib/JobState.php lib/OverviewPage.php
msgid "Pending"
msgstr "Hangend"

#: lib/JobState.php lib/OverviewPage.php lib/ReasonFamily.php
msgid "Held"
msgstr "Teruggehou"

#: lib/JobState.php lib/OverviewPage.php
msgid "Running"
msgstr "Loopend"

