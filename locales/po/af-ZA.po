#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Die HPC Scheduler-sjablone is nie geïnstalleer nie. Installeer dit vanaf die gesondheidsbladsy."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "'n Toestel \"%s\" vanaf die %s-toestelsjabloon, gepol deur poller %d, met beskikbaarheidskontroles af."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Die datanavraag \"%s\", wat die %d partisies wat nou bekend is, indekseer."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d klustergrafieke, elkeen met sy eie \"%s\"-databron."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d partisiegrafieke, %d vir elke partisie, elkeen met sy eie databron."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "In totaal: %d databronne en %d RRD-lêers, en %d skripbedieneroproepe per pol. Partisies wat later bygevoeg word, kry grafieke vanaf die Nuwe Grafieke-bladsy."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Geskep deur die HPC Scheduler-inprop vir kluster %s. Sy waardes kom vanaf die inpropmomentopname; die gasheernaam is 'n gereserveerde naam wat nooit gekontak word nie."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "opstelling: 'n pad, URL of instelling ontbreek of word nie toegelaat nie"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "die skeduleerder kon nie bereik word nie"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "die oproep het langer geneem as wat toegelaat word en is gestop"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "die antwoord was groter as wat toegelaat word en is weggegooi"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "die antwoord kon nie met die vasgemaakte data-ontleder ontleed word nie"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "die skeduleerder het die geloofsbrief geweier"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "die skeduleerderrekening mag nie hierdie data sien nie (PrivateData of toestemmings)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "die beheerder het kliënte gevra om terug te staan (tempobeperking)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "die bediener het 304 geantwoord op 'n versoek wat nie voorwaardelik was nie; vorige data behou"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "die inprop het 'n oproep buite sy toelatingslys geweier"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "die oproep het misluk"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "die leser het sonder geheue geraak; verlaag Maksimum Antwoordgrootte of verhoog Insamelingsgeheue in Opstelling"

