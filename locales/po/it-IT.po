#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "I modelli di HPC Scheduler non sono installati. Installarli dalla pagina dello stato di integrità."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Un dispositivo \"%s\" dal modello di dispositivo %s, interrogato dal poller %d, con controlli di disponibilità disattivati."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "La query dati \"%s\", che indicizza le %d partizioni attualmente note."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d grafici del cluster, ciascuno con la propria origine dati \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d grafici delle partizioni, %d per ciascuna partizione, ciascuno con la propria origine dati."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "In totale: %d origini dati, %d file RRD e %d chiamate allo script server per ogni polling. Le partizioni aggiunte successivamente ricevono i grafici dalla pagina Nuovi grafici."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Creato dal plugin HPC Scheduler per il cluster %s. I relativi valori provengono dall'istantanea del plugin; il nome host è un nome riservato che non viene mai contattato."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configurazione: un percorso, un URL o un'impostazione è mancante o non consentita"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "impossibile raggiungere lo scheduler"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "la chiamata ha superato il tempo consentito ed è stata interrotta"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "la risposta ha superato la dimensione consentita ed è stata scartata"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "impossibile analizzare la risposta con il parser dati fissato"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "lo scheduler ha rifiutato le credenziali"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "l'account dello scheduler potrebbe non essere autorizzato a visualizzare questi dati (PrivateData o autorizzazioni)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "il controller ha chiesto ai client di rallentare (limite di frequenza)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "il server ha risposto 304 a una richiesta non condizionale; dati precedenti mantenuti"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "il plugin ha rifiutato una chiamata al di fuori della propria lista consentita"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "la chiamata non è riuscita"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "il lettore ha esaurito la memoria; ridurre la Dimensione massima della risposta o aumentare la Memoria di raccolta nelle Impostazioni"

