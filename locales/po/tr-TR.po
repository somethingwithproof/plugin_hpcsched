#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Maksimum Yanıt Boyutu %d MiB, ancak bu boyuttaki kodu çözülmüş bir yanıt %d MiB Toplama Belleğine sığmıyor; okuyucu %d MiB'ye izin veriyor. Ayarlar içinde Toplama Belleğini artırın veya Maksimum Yanıt Boyutunu düşürün."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Uzak bir veri toplayıcı olan %d numaralı yoklayıcıya atandı. Bu sürüm yalnızca ana yoklayıcı üzerinde toplama yapar, bu nedenle küme toplanmıyor; uzak toplama 3. aşama için planlanmıştır. Ana yoklayıcıya atayın."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Toplama aralığı %d saniyelik alt sınırın altında."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "%d saniyelik toplama aralığı, %d saniyelik yoklayıcı aralığından daha kısa; veriler her %d saniyede bir toplanır."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "slurmrestd'ye geri döngü adresi üzerinden düz HTTP ile ulaşılıyor; belirteç yerel ağ yığınından şifrelenmeden geçiyor."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Bu küme için henüz hiçbir okuyucu çalıştırması tamamlanmadı."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Belirteç dosyası: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Belirtecin süresi %s doldu."

