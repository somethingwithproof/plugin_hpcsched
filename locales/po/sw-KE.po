#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Violezo vya HPC Scheduler havijasakinishwa. Visakinishe kutoka ukurasa wa afya."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Kifaa \"%s\" kutoka kwa kiolezo cha kifaa cha %s, kikikusanywa na mkusanyaji %d, huku ukaguzi wa upatikanaji ukiwa umezimwa."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Hoja ya data \"%s\", ikiorodhesha sehemu %d zinazojulikana sasa."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Grafu %d za klasta, kila moja ikiwa na chanzo chake cha data \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Grafu %d za sehemu, %d kwa kila sehemu, kila moja ikiwa na chanzo chake cha data."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Kwa jumla: vyanzo %d vya data na faili %d za RRD, na miito %d ya seva ya hati kwa kila ukusanyaji. Sehemu zilizoongezwa baadaye hupata grafu kutoka ukurasa wa Grafu Mpya."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Imeundwa na programu-jalizi ya HPC Scheduler kwa klasta %s. Thamani zake zinatoka kwenye picha ya hali ya programu-jalizi; jina la mwenyeji ni jina lililohifadhiwa ambalo haliwasilianwi kamwe."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "usanidi: njia, URL, au mpangilio umekosekana au hauruhusiwi"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "kipanga ratiba hakikuweza kufikiwa"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "mwito ulichukua muda mrefu kuliko ilivyoruhusiwa na ukasimamishwa"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "jibu lilikuwa kubwa kuliko ilivyoruhusiwa na likatupiliwa mbali"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "jibu halikuweza kuchanganuliwa na kichanganuzi cha data kilichobandikwa"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "kipanga ratiba kilikataa kitambulisho"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "akaunti ya kipanga ratiba huenda isione data hii (PrivateData au ruhusa)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "kidhibiti kiliomba wateja wapunguze kasi (kikomo cha kiwango)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "seva ilijibu 304 kwa ombi ambalo halikuwa la masharti; data ya awali imehifadhiwa"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "programu-jalizi ilikataa mwito ulio nje ya orodha yake ya ruhusa"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "mwito ulishindwa"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "kisomaji kiliishiwa na kumbukumbu; punguza Ukubwa wa Juu wa Jibu au ongeza Kumbukumbu ya Ukusanyaji katika Mipangilio"

