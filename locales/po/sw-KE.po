#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Ukubwa wa Juu wa Jibu ni %d MiB, lakini jibu lililosimbuliwa la ukubwa huo halitoshei katika Kumbukumbu ya Ukusanyaji ya %d MiB; kisomaji kinaruhusu %d MiB. Ongeza Kumbukumbu ya Ukusanyaji au punguza Ukubwa wa Juu wa Jibu katika Mipangilio."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Imepewa mkusanyaji %d, mkusanyaji data wa mbali. Toleo hili linakusanya kwenye mkusanyaji mkuu pekee, kwa hivyo klasta haikusanywi; ukusanyaji wa mbali umepangwa kwa awamu ya 3. Ipe mkusanyaji mkuu."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Muda wa ukusanyaji uko chini ya kiwango cha chini cha sekunde %d."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Muda wa ukusanyaji wa sekunde %d ni mfupi kuliko muda wa mkusanyaji wa sekunde %d; data inakusanywa kila baada ya sekunde %d."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "slurmrestd inafikiwa kupitia HTTP ya kawaida kwenye anwani ya loopback; tokeni hupita kwenye mtandao wa ndani bila kusimbwa."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Hakuna uendeshaji wa kisomaji uliomalizika kwa klasta hii bado."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Faili ya tokeni: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Tokeni iliisha muda wake %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Tokeni itaisha muda wake baada ya dakika %d."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "Uendeshaji wa mwisho ulitumia bajeti yake yote ya muda ya sekunde %d; baadhi ya sehemu hazikukusanywa."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "Kipanga ratiba kinaripoti Slurm %s, ambayo si toleo linalotumika (%s)."

#: lib/HealthWarnings.php
