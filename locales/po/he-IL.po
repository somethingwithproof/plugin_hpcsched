#: lib/ClustersPage.php
msgid "Reindex Partitions"
msgstr "אנדקס מחיצות מחדש"

#: lib/ClustersPage.php
msgid "Unmap"
msgstr "בטל מיפוי"

#: lib/ClustersPage.php
msgid "Unmapping keeps the device, its graphs, and their history."
msgstr "ביטול המיפוי שומר על ההתקן, הגרפים שלו וההיסטוריה שלהם."

#: lib/ClustersPage.php
#, php-format
msgid "The cluster is still mapped to device %d, which no longer exists. Creating or mapping a device replaces that mapping."
msgstr "האשכול עדיין ממופה להתקן %d, שאינו קיים עוד. יצירה או מיפוי של התקן מחליפים מיפוי זה."

#: lib/ClustersPage.php
msgid "Creating a device adds:"
msgstr "יצירת התקן מוסיפה:"

#: lib/ClustersPage.php
msgid "Without partition graphs, only the cluster graphs are created, and the data sources and calls for the partitions above are left out."
msgstr "ללא גרפי מחיצות, נוצרים רק גרפי האשכול, ומקורות הנתונים והקריאות עבור המחיצות שלמעלה מושמטים."

#: lib/ClustersPage.php
msgid "Also create the partition graphs"
msgstr "צור גם את גרפי המחיצות"

#: lib/ClustersPage.php
msgid "Create Device"
msgstr "צור התקן"

#: lib/ClustersPage.php
msgid "Or map an existing device"
msgstr "או מפה התקן קיים"

#: lib/ClustersPage.php
msgid "Map Device"
msgstr "מפה התקן"

#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "תבניות מתזמן HPC אינן מותקנות. התקן אותן מדף התקינות."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "התקן \"%s\" מתבנית ההתקן %s, הנדגם על ידי דוגם %d, כאשר בדיקות הזמינות כבויות."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "שאילתת הנתונים \"%s\", שמאנדקסת את %d המחיצות המוכרות כעת."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d גרפי אשכול, שלכל אחד מהם מקור נתונים \"%s\" משלו."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d גרפי מחיצות, %d עבור כל מחיצה, שלכל אחד מהם מקור נתונים משלו."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "בסך הכל: %d מקורות נתונים ו-%d קובצי RRD, ו-%d קריאות שרת סקריפטים בכל דגימה. מחיצות שיתווספו מאוחר יותר יקבלו גרפים מדף הגרפים החדשים."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "נוצר על ידי תוסף מתזמן HPC עבור אשכול %s. הערכים שלו מגיעים מתמונת המצב של התוסף; שם המארח הוא שם שמור שלעולם לא מתבצעת אליו פנייה."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "תצורה: נתיב, כתובת URL או הגדרה חסרים או אסורים"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "לא ניתן היה ליצור קשר עם המתזמן"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "הקריאה נמשכה מעבר למותר ונעצרה"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "התשובה הייתה גדולה מהמותר ונזרקה"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "לא ניתן היה לנתח את התשובה באמצעות מפענח הנתונים המקובע"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "המתזמן סירב לפרטי האימות"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "חשבון המתזמן אינו רשאי לראות נתונים אלה (PrivateData או הרשאות)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "הבקר ביקש מלקוחות להמתין (מגבלת קצב)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "השרת החזיר 304 לבקשה שלא הייתה מותנית; הנתונים הקודמים נשמרו"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "התוסף סירב לקריאה מחוץ לרשימת ההיתרים שלו"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "הקריאה נכשלה"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "לקורא אזל הזיכרון; הקטן את גודל התשובה המרבי או הגדל את זיכרון האיסוף בהגדרות"

