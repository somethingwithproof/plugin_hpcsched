#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Amathempulethi e-HPC Scheduler awafakiwe. Wafake kusuka ekhasini lezempilo."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Idivayisi \"%s\" evela kuthempulethi yedivayisi ye-%s, eqoqwe yi-poller %d, lapho ukuhlolwa kokutholakala kuvaliwe."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Umbuzo wedatha \"%s\", obeka kuhlu amaphathishini angu-%d aziwayo manje."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Amagrafu eklasta angu-%d, ngalinye linomthombo walo wedatha othi \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Amagrafu ephathishini angu-%d, angu-%d ephathishini ngayinye, ngalinye linomthombo walo wedatha."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Sekukonke: imithombo yedatha engu-%d namafayela e-RRD angu-%d, kanye nokubizwa kweseva yeskripthi okungu-%d ekuqoqeni ngakunye. Amaphathishini engezwe kamuva athola amagrafu ekhasini le-New Graphs."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Kudalwe yi-plugin ye-HPC Scheduler yeklasta %s. Amanani ayo avela ku-snapshot ye-plugin; igama lomsingathi yigama eligodliwe elingathintwa nakanye."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "ukulungiselelwa: indlela, i-URL, noma isilungiselelo asikho noma asivunyelwe"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "isihleli asikwazanga ukufinyelelwa"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "ukubizwa kuthathe isikhathi eside kunesivunyelwe futhi kwamiswa"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "impendulo ibinkulu kunesivunyelwe futhi yalahlwa"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "impendulo ayikwazanga ukuhlaziywa ngesihlaziya sedatha esiphiniwe"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "isihleli senqabile isiqinisekiso"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "i-akhawunti yesihleli kungenzeka ingayiboni le datha (i-PrivateData noma izimvume)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "isilawuli sicele amaklayenti ukuba ehle (umkhawulo wezinga)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "iseva iphendule ngo-304 esicelweni esasingenamibandela; idatha yangaphambilini igciniwe"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "i-plugin yenqabile ukubizwa okungaphandle kohlu lwayo oluvunyelwe"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "ukubizwa kwehlulekile"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "umfundi uphelelwe yinkumbulo; yehlisa i-Maximum Answer Size noma wenyuse i-Collection Memory ku-Izilungiselelo"

