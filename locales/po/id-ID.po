#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Templat HPC Scheduler belum diinstal. Instal templat tersebut dari halaman kesehatan."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Perangkat \"%s\" dari templat perangkat %s, dilakukan polling oleh poller %d, dengan pemeriksaan ketersediaan dimatikan."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Kueri data \"%s\", mengindeks %d partisi yang diketahui saat ini."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d grafik klaster, masing-masing dengan sumber data \"%s\" miliknya sendiri."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d grafik partisi, %d untuk setiap partisi, masing-masing dengan sumber datanya sendiri."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Secara keseluruhan: %d sumber data dan %d file RRD, serta %d panggilan server skrip per polling. Partisi yang ditambahkan kemudian memperoleh grafik dari halaman Grafik Baru."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Dibuat oleh plugin HPC Scheduler untuk klaster %s. Nilainya berasal dari snapshot plugin; nama host merupakan nama cadangan yang tidak pernah dihubungi."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "konfigurasi: jalur, URL, atau pengaturan tidak ada atau tidak diizinkan"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "penjadwal tidak dapat dihubungi"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "panggilan berlangsung lebih lama dari yang diizinkan dan dihentikan"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "jawaban lebih besar dari yang diizinkan dan dibuang"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "jawaban tidak dapat diurai dengan pengurai data yang disematkan"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "penjadwal menolak kredensial"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "akun penjadwal mungkin tidak dapat melihat data ini (PrivateData atau izin)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "pengendali meminta klien untuk mundur sementara (batas laju)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "server menjawab 304 untuk permintaan yang tidak bersyarat; data sebelumnya dipertahankan"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "plugin menolak panggilan di luar daftar izinnya"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "panggilan gagal"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "pembaca kehabisan memori; turunkan Ukuran Jawaban Maksimum atau naikkan Memori Pengumpulan di Pengaturan"

