msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Kopā: %d datu avoti un %d RRD faili, kā arī %d skriptu servera izsaukumi vienā aptaujā. Vēlāk pievienotajām partīcijām grafikus var izveidot lapā Jauni grafiki."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Izveidoja HPC plānotāja spraudnis klasterim %s. Tās vērtības tiek ņemtas no spraudņa momentuzņēmuma; resursdatora nosaukums ir rezervēts nosaukums, ar kuru nekad netiek veidots savienojums."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "konfigurācija: ceļš, URL vai iestatījums trūkst vai nav atļauts"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "plānotāju nevarēja sasniegt"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "izsaukums ilga ilgāk par atļauto un tika apturēts"

