msgstr "plānotāja konts nedrīkst redzēt šos datus (PrivateData vai atļaujas)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "kontrolieris lūdza klientiem samazināt pieprasījumus (biežuma ierobežojums)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "serveris atbildēja ar 304 uz pieprasījumu, kas nebija nosacīts; iepriekšējie dati saglabāti"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "spraudnis noraidīja izsaukumu ārpus tā atļauto saraksta"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "izsaukums neizdevās"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "lasītājam pietrūka atmiņas; samaziniet Maksimālo atbildes lielumu vai palieliniet Datu vākšanas atmiņu Iestatījumos"

