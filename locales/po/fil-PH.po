msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configuration: may path, URL, o setting na nawawala o hindi pinapayagan"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "hindi maabot ang scheduler"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "mas matagal ang tawag kaysa sa pinapayagan at pinahinto"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "mas malaki ang sagot kaysa sa pinapayagan at itinapon"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "hindi ma-parse ang sagot gamit ang naka-pin na data parser"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "tinanggihan ng scheduler ang kredensyal"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "maaaring hindi makita ng scheduler account ang data na ito (PrivateData o mga pahintulot)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "hiniling ng controller sa mga client na maghinay-hinay (rate limit)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "sumagot ang server ng 304 sa isang kahilingang hindi kondisyonal; pinanatili ang nakaraang data"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "tinanggihan ng plugin ang isang tawag na wala sa allowlist nito"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "nabigo ang tawag"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "naubusan ng memory ang reader; babaan ang Pinakamataas na Laki ng Sagot o itaas ang Memory sa Pangongolekta sa Mga Setting"

