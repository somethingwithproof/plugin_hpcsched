#: lib/HealthWarnings.php
#, php-format
msgid "Maximum Answer Size is %d MiB, but a decoded answer of that size does not fit in the Collection Memory of %d MiB; the reader allows %d MiB. Raise Collection Memory or lower Maximum Answer Size in Settings."
msgstr "Ang Pinakamataas na Laki ng Sagot ay %d MiB, ngunit ang na-decode na sagot na ganoon kalaki ay hindi kasya sa Memory sa Pangongolekta na %d MiB; pinapayagan ng reader ang %d MiB. Itaas ang Memory sa Pangongolekta o babaan ang Pinakamataas na Laki ng Sagot sa Mga Setting."

#: lib/HealthWarnings.php
#, php-format
msgid "Assigned to poller %d, a remote data collector. This release collects only on the main poller, so the cluster is not collected; remote collection is planned for phase 3. Assign it to the main poller."
msgstr "Nakatalaga sa poller %d, isang remote na tagakolekta ng data. Nangongolekta lamang ang bersyong ito sa pangunahing poller, kaya hindi kinokolekta ang cluster; nakaplano ang remote na pangongolekta para sa yugto 3. Italaga ito sa pangunahing poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval is below the %d second floor."
msgstr "Ang agwat ng pangongolekta ay mas mababa sa %d segundong pinakamababang hangganan."

#: lib/HealthWarnings.php
#, php-format
msgid "The collection interval of %d seconds is shorter than the poller interval of %d seconds; data is collected every %d seconds."
msgstr "Ang agwat ng pangongolekta na %d segundo ay mas maikli kaysa sa agwat ng poller na %d segundo; kinokolekta ang data tuwing %d segundo."

#: lib/HealthWarnings.php
msgid "slurmrestd is reached over plain HTTP on the loopback address; the token crosses the local network stack unencrypted."
msgstr "Naaabot ang slurmrestd sa pamamagitan ng plain na HTTP sa loopback address; dumadaan ang token sa lokal na network stack nang hindi naka-encrypt."

#: lib/HealthWarnings.php
msgid "No reader run has finished for this cluster yet."
msgstr "Wala pang natapos na pagtakbo ng reader para sa cluster na ito."

#: lib/HealthWarnings.php
#, php-format
msgid "Token file: %s."
msgstr "Token file: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expired %s."
msgstr "Nag-expire ang token %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The token expires in %d minutes."
msgstr "Mag-e-expire ang token sa loob ng %d minuto."

#: lib/HealthWarnings.php
#, php-format
msgid "The last run used its whole time budget of %d seconds; some sections were not collected."
msgstr "Ginamit ng huling pagtakbo ang buong badyet sa oras na %d segundo; hindi nakolekta ang ilang seksyon."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which is not a supported release (%s)."
msgstr "Iniuulat ng scheduler ang Slurm %s, na hindi suportadong bersyon (%s)."

#: lib/HealthWarnings.php
#, php-format
msgid "The scheduler reports Slurm %s, which does not ship the data parser %s chosen in Settings."
msgstr "Iniuulat ng scheduler ang Slurm %s, na hindi naglalaman ng data parser na %s na pinili sa Mga Setting."

#: lib/HealthWarnings.php
msgid "Client commands ran without a memory limit; set the prlimit path in Settings."
msgstr "Tumakbo ang mga client command nang walang limitasyon sa memory; itakda ang path ng prlimit sa Mga Setting."

#: lib/HealthWarnings.php
#, php-format
msgid "Last error: %s."
msgstr "Huling error: %s."

#: lib/HealthWarnings.php
#, php-format
msgid "Collection is paused for %d seconds after a rate limit."
msgstr "Naka-pause ang pangongolekta sa loob ng %d segundo pagkatapos ng isang rate limit."

#: lib/HealthWarnings.php
msgid "Data is stale; graphs and alerts read it as unknown."
msgstr "Luma na ang data; binabasa ito ng mga graph at alerto bilang hindi alam."

