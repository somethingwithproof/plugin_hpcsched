#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Hindi naka-install ang mga template ng HPC Scheduler. I-install ang mga ito mula sa pahina ng kalusugan."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Isang device na \"%s\" mula sa device template ng %s, na pino-poll ng poller %d, nang naka-off ang mga pagsusuri sa availability."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Ang data query na \"%s\", na nag-i-index ng %d partition na alam ngayon."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d na cluster graph, bawat isa ay may sarili nitong \"%s\" data source."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d na partition graph, %d para sa bawat partition, bawat isa ay may sarili nitong data source."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Sa kabuuan: %d na data source at %d na RRD file, at %d na tawag sa script server bawat poll. Ang mga partition na idinagdag pagkatapos ay nakakakuha ng mga graph mula sa pahina ng Mga Bagong Graph."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Ginawa ng HPC Scheduler plugin para sa cluster na %s. Ang mga halaga nito ay nagmumula sa snapshot ng plugin; ang host name ay isang nakareserbang pangalan na hindi kailanman kinokontak."

