#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Szablony HPC Scheduler nie są zainstalowane. Zainstaluj je ze strony stanu."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Urządzenie „%s” z szablonu urządzenia %s, odpytywane przez poller %d, z wyłączonym sprawdzaniem dostępności."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Zapytanie danych „%s”, indeksujące %d obecnie znanych partycji."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Wykresy klastra: %d, każdy z własnym źródłem danych „%s”."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Wykresy partycji: %d (%d na każdą partycję), każdy z własnym źródłem danych."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Łącznie: źródła danych (%d), pliki RRD (%d) oraz wywołania serwera skryptów na odpytanie (%d). Partycje dodane później otrzymają wykresy na stronie Nowe wykresy."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Utworzone przez wtyczkę HPC Scheduler dla klastra %s. Wartości pochodzą z migawki wtyczki; nazwa hosta jest nazwą zastrzeżoną, z którą nigdy nie nawiązuje się połączenia."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "konfiguracja: brak ścieżki, adresu URL lub ustawienia albo są one niedozwolone"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "nie można nawiązać połączenia z harmonogramem"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "wywołanie trwało dłużej niż dozwolono i zostało zatrzymane"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "odpowiedź była większa niż dozwolono i została odrzucona"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "odpowiedź nie mogła zostać przeanalizowana za pomocą przypiętego parsera danych"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "harmonogram odrzucił poświadczenie"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "konto harmonogramu może nie mieć dostępu do tych danych (PrivateData lub uprawnienia)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "kontroler poprosił klientów o zwolnienie tempa (limit szybkości)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "serwer odpowiedział kodem 304 na żądanie, które nie było warunkowe; zachowano poprzednie dane"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "wtyczka odrzuciła wywołanie spoza swojej listy dozwolonych"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "wywołanie nie powiodło się"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "czytnikowi zabrakło pamięci; zmniejsz maksymalny rozmiar odpowiedzi lub zwiększ pamięć zbierania w Ustawieniach"

