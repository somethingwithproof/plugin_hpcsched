#: lib/DeviceProvisioner.php
msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Tsy napetraka ireo modely HPC Scheduler. Apetraho avy ao amin'ny pejin'ny fahasalamana izy ireo."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Fitaovana \"%s\" avy amin'ny modely fitaovana %s, angonin'ny poller %d, miaraka amin'ny fanamarinana fahafahana miasa tsy alefa."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "Ny fangatahana rakitra \"%s\", manondro ireo partition %d fantatra amin'izao fotoana izao."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "Grafika cluster %d, samy manana ny loharanon-drakiny \"%s\" avy."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "Grafika partition %d, %d isaky ny partition, samy manana ny loharanon-drakiny avy."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Amin'ny fitambarany: loharanon-drakitra %d sy rakitra RRD %d, ary antso mpizara script %d isaky ny fanangonana. Ireo partition ampiana any aoriana dia mahazo grafika avy ao amin'ny pejy Grafika Vaovao."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Noforonin'ny plugin HPC Scheduler ho an'ny cluster %s. Avy amin'ny snapshot an'ny plugin ny sandany; anarana voatokana tsy ifandraisana mihitsy ny anaran'ny mpampiantrano."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "fikirakirana: misy lalana, URL, na fikirakirana tsy ampy na tsy azo atao"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "tsy azo nifandraisana ny scheduler"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "naharitra ela loatra noho ny nahazoana alalana ny antso ka najanona"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "lehibe loatra noho ny nahazoana alalana ny valiny ka nariana"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "tsy azo nofakafakaina tamin'ny mpandinika rakitra voatondro ny valiny"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "nolavin'ny scheduler ny fanamarinana"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "mety tsy mahazo mahita ity rakitra ity ny kaonty scheduler (PrivateData na fahazoan-dalana)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "nangataka ireo mpanjifa hihena ny fifamoivoizana ny mpanara-maso (fetran'ny tahan'ny fangatahana)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "namaly 304 ny mpizara tamin'ny fangatahana tsy nisy fepetra; notazonina ny rakitra teo aloha"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "nolavin'ny plugin ny antso ivelan'ny lisitra nahazoana alalana"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "tsy nahomby ny antso"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "lany fitadidiana ny mpamaky; ampidino ny Haben'ny Valiny Fara Fahabetsany na ampiakaro ny Fitadidiana Fanangonana ao amin'ny Fikirakirana"

