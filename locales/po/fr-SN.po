msgid "The HPC Scheduler templates are not installed. Install them from the health page."
msgstr "Les modèles HPC Scheduler ne sont pas installés. Installez-les depuis la page de santé."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Un appareil \"%s\" issu du modèle d'appareil %s, interrogé par le collecteur %d, avec les vérifications de disponibilité désactivées."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", indexing the %d partitions known now."
msgstr "La requête de données \"%s\", indexant les %d partitions actuellement connues."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d cluster graphs, each with its own \"%s\" data source."
msgstr "%d graphiques de cluster, chacun avec sa propre source de données \"%s\"."

#: lib/DeviceProvisioner.php
#, php-format
msgid "%d partition graphs, %d for each partition, each with its own data source."
msgstr "%d graphiques de partition, %d pour chaque partition, chacun avec sa propre source de données."

#: lib/DeviceProvisioner.php
#, php-format
msgid "In all: %d data sources and %d RRD files, and %d script server calls per poll. Partitions added later get graphs from the New Graphs page."
msgstr "Au total : %d sources de données et %d fichiers RRD, et %d appels au serveur de scripts par collecte. Les partitions ajoutées ultérieurement obtiennent leurs graphiques depuis la page Nouveaux graphiques."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the HPC Scheduler plugin for cluster %s. Its values come from the plugin snapshot; the host name is a reserved name that is never contacted."
msgstr "Créé par l'extension HPC Scheduler pour le cluster %s. Ses valeurs proviennent de l'instantané de l'extension ; le nom d'hôte est un nom réservé qui n'est jamais contacté."

#: lib/ErrorClass.php
msgid "configuration: a path, URL, or setting is missing or not allowed"
msgstr "configuration : un chemin, une URL ou un paramètre est manquant ou non autorisé"

#: lib/ErrorClass.php
msgid "the scheduler could not be reached"
msgstr "l'ordonnanceur n'a pas pu être joint"

#: lib/ErrorClass.php
msgid "the call took longer than allowed and was stopped"
msgstr "l'appel a duré plus longtemps que permis et a été arrêté"

#: lib/ErrorClass.php
msgid "the answer was larger than allowed and was discarded"
msgstr "la réponse était plus volumineuse que permis et a été rejetée"

#: lib/ErrorClass.php
msgid "the answer could not be parsed with the pinned data parser"
msgstr "la réponse n'a pas pu être analysée avec l'analyseur de données fixé"

#: lib/ErrorClass.php
msgid "the scheduler refused the credential"
msgstr "l'ordonnanceur a refusé l'identifiant"

#: lib/ErrorClass.php
msgid "the scheduler account may not see this data (PrivateData or permissions)"
msgstr "le compte de l'ordonnanceur n'est peut-être pas autorisé à voir ces données (PrivateData ou autorisations)"

#: lib/ErrorClass.php
msgid "the controller asked clients to back off (rate limit)"
msgstr "le contrôleur a demandé aux clients de ralentir (limite de débit)"

#: lib/ErrorClass.php
msgid "the server answered 304 to a request that was not conditional; previous data kept"
msgstr "le serveur a répondu 304 à une requête qui n'était pas conditionnelle ; les données précédentes ont été conservées"

#: lib/ErrorClass.php
msgid "the plugin refused a call outside its allowlist"
msgstr "l'extension a refusé un appel hors de sa liste d'autorisation"

#: lib/ErrorClass.php
msgid "the call failed"
msgstr "l'appel a échoué"

#: lib/ErrorClass.php
msgid "the reader ran out of memory; lower Maximum Answer Size or raise Collection Memory in Settings"
msgstr "le lecteur a manqué de mémoire ; réduisez la taille maximale de réponse ou augmentez la mémoire de collecte dans Paramètres"

