{
  "note": "Synthetic names only (example.org, RFC 5737 and 10/8 addresses). Expected values are the proposal this prototype should make, not scheduler output.",
  "cases": [
    {"id": "equal-names",
     "nodes": [{"name": "a1", "hostname": "a1", "address": "a1"}],
     "devices": [{"id": 1, "hostname": "a1", "description": "a1"}],
     "expect": {"a1": {"state": "proposed", "device": 1, "tier": 1}}},
    {"id": "device-has-fqdn",
     "nodes": [{"name": "n01", "hostname": "n01", "address": "n01"}],
     "devices": [{"id": 1, "hostname": "n01.example.org", "description": "rack 4 node"}],
     "expect": {"n01": {"state": "proposed", "device": 1, "tier": 4}}},
    {"id": "arbitrary-nodename",
     "nodes": [{"name": "gpu-a", "hostname": "r1c2.example.org", "address": "r1c2.example.org"}],
     "devices": [{"id": 7, "hostname": "R1C2.example.org.", "description": "gpu box"}],
     "expect": {"gpu-a": {"state": "proposed", "device": 7, "tier": 1}}},
    {"id": "address-is-ip",
     "nodes": [{"name": "n02", "hostname": "n02", "address": "10.0.0.5"}],
     "devices": [{"id": 2, "hostname": "10.0.0.5", "description": "other"}],
     "expect": {"n02": {"state": "proposed", "device": 2, "tier": 2}}},
    {"id": "description-carries-name",
     "nodes": [{"name": "n05", "hostname": "n05", "address": "10.1.1.1"}],
     "devices": [{"id": 3, "hostname": "192.0.2.9", "description": "n05"}],
     "expect": {"n05": {"state": "proposed", "device": 3, "tier": 3}}},
    {"id": "duplicate-devices",
     "nodes": [{"name": "d1", "hostname": "d1", "address": "d1"}],
     "devices": [{"id": 1, "hostname": "d1", "description": "a"}, {"id": 2, "hostname": "d1", "description": "b"}],
     "expect": {"d1": {"state": "ambiguous", "tier": 1}}},
    {"id": "two-nodes-one-device",
     "nodes": [{"name": "x1", "hostname": "shared", "address": "shared"}, {"name": "x2", "hostname": "shared", "address": "shared"}],
     "devices": [{"id": 9, "hostname": "shared", "description": "s"}],
     "expect": {"x1": {"state": "ambiguous", "tier": 1}, "x2": {"state": "ambiguous", "tier": 1}}},
    {"id": "node-in-two-partitions",
     "nodes": [{"name": "p1", "hostname": "p1", "address": "p1"}, {"name": "p1", "hostname": "p1", "address": "p1"}],
     "devices": [{"id": 4, "hostname": "p1", "description": "p"}],
     "expect": {"p1": {"state": "proposed", "device": 4, "tier": 1}}},
    {"id": "no-device",
     "nodes": [{"name": "lonely", "hostname": "lonely", "address": "lonely"}],
     "devices": [{"id": 5, "hostname": "other", "description": "other"}],
     "expect": {"lonely": {"state": "unmatched"}}},
    {"id": "short-label-collision",
     "nodes": [{"name": "n1", "hostname": "n1", "address": "n1"}],
     "devices": [{"id": 1, "hostname": "n1.a.example.org", "description": "a"}, {"id": 2, "hostname": "n1.b.example.org", "description": "b"}],
     "expect": {"n1": {"state": "ambiguous", "tier": 4}}},
    {"id": "ip-is-not-a-short-label",
     "nodes": [{"name": "10", "hostname": "10", "address": "10"}],
     "devices": [{"id": 6, "hostname": "10.0.0.5", "description": "ip"}],
     "expect": {"10": {"state": "unmatched"}}}
  ]
}
