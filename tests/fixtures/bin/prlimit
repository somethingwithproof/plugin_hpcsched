# Stand-in for util-linux prlimit in tests: records the limit it was asked to
# apply and runs the command, which is what prlimit does after setting it.
set -u

dir=$(sed -n 2p "$SLURM_CONF")
printf '%s\n' "$1" >> "$dir/prlimit.txt"
shift
[ "${1:-}" = "--" ] && shift
exec "$@"
