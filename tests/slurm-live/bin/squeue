# The Slurm client commands of the live CI cluster, for the plugin's command
# transport: the client binaries run inside the slurmctld container, which
# has the cluster's slurm.conf and munge. squeue, scontrol, and sshare are
# this one script. The transport runs it with PATH=/usr/bin:/bin, which
# finds docker on the runner; the others are where macOS installs put it.
PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin:${HOME:-/nonexistent}/.orbstack/bin
exec docker exec slurmctld "$(basename "$0")" "$@"
